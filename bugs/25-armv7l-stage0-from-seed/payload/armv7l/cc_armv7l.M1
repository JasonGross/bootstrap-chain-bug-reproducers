    '001098E5'    ; ldr r1, [r8]    # Set divisor to largest positive number that fits in 32bits
    '000056E3'    ; cmp r6, #0    # Deal with 0 case
    ^~numerate_number_ZERO JUMP_EQUAL    ; beq numerate_number_ZERO    # If it is
    ^~numerate_number_positive JUMP_GT    ; bgt numerate_number_positive    # If it is positive
    ## Deal with negative case
    '2D00A0E3'    ; mov r0, #45    # Using "-"
    '0000C4E5'    ; strb r0, [r4]    # Write it
    '014084E2'    ; add r4, #1    # increment
    '0080E0E3'    ; mov r8, #-1
    '960806E0'    ; mul r6, r8    # A = A * -1

:numerate_number_positive ; .text offset 0x4868, vaddr 0x148bc
    '0600A0E1'    ; mov r0, r6    # Using A as bottom
    '04102DE5'    ; push {r1}    # protect our divisor
    '04E02DE5'    ; push {r14}
    ^~divides CALL_ALWAYS    ; bl divides    # r0 / r1 -> r0 + r0 % r1 -> r1 [since I have to implement division manually]
    '04E09DE4'    ; pop {r14}
    '04109DE4'    ; pop {r1}    # restore our divisor
    '000050E3'    ; cmp r0, #0    # IF 0 == (a / divisor)
    ^~numerate_number_iter JUMP_NE    ; bne numerate_number_iter    # Clean up those leading Zeros
    '0100A0E1'    ; mov r0, r1    # Using Divisor for bottom
    '0A10A0E3'    ; mov r1, #10    # Make this shit work because idiv 10 doesn't work
    '04E02DE5'    ; push {r14}
    ^~divides CALL_ALWAYS    ; bl divides    # r0 / r1 -> r0 + r0 % r1 -> r1 [since I have to implement division manually]
    '04E09DE4'    ; pop {r14}
    '0010A0E1'    ; mov r1, r0    # Update divisor
    ^~numerate_number_positive JUMP_ALWAYS    ; b numerate_number_positive    # Keep collecting

:numerate_number_iter ; .text offset 0x48a4, vaddr 0x148f8
    '000051E3'    ; cmp r1, #0    # IF DIVISOR < 0
    ^~numerate_number_done JUMP_LE    ; ble numerate_number_done    # Be done
    '0600A0E1'    ; mov r0, r6    # Using A as bottom
    '04102DE5'    ; push {r1}    # protect our divisor
    '04E02DE5'    ; push {r14}
    ^~divides CALL_ALWAYS    ; bl divides    # r0 / r1 -> r0 + r0 % r1 -> r1 [since I have to implement division manually]
    '04E09DE4'    ; pop {r14}
    '0160A0E1'    ; mov r6, r1    # a = a % divisor
    '04109DE4'    ; pop {r1}    # restore our divisor
    '300080E2'    ; add r0, #48    # ((a / divisor) + 48)
    '0000C4E5'    ; strb r0, [r4]    # Write it
    '0100A0E1'    ; mov r0, r1    # Using Divisor for bottom
    '0A10A0E3'    ; mov r1, #10    # Make this shit work because idiv 10 doesn't work
    '04E02DE5'    ; push {r14}
    ^~divides CALL_ALWAYS    ; bl divides    # r0 / r1 -> r0 + r0 % r1 -> r1 [since I have to implement division manually]
    '04E09DE4'    ; pop {r14}
    '0010A0E1'    ; mov r1, r0    # Update divisor
    '014084E2'    ; add r4, #1    # increment
    ^~numerate_number_iter JUMP_ALWAYS    ; b numerate_number_iter    # Keep going

