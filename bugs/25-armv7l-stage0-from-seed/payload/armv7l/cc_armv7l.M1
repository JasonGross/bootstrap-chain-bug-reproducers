## DEFINEs: ARM condition/opcode top bytes for ^~ branch words
## (names and values match M2libc armv7l_defs.M1)
DEFINE CALL_ALWAYS EB
DEFINE JUMP_ALWAYS EA
DEFINE JUMP_EQUAL 0A
DEFINE JUMP_GT CA
DEFINE JUMP_LE DA
DEFINE JUMP_LT BA
DEFINE JUMP_NE 1A

    ## Register usage:
    ## R0 => Temps
    ## R8 => address scratch register because ARM can't handle 12bit immediates/offsets correctly or have a swap/xchg instruction
    ## R11 => function_address
    ## R12 => global_token_address
    ## Struct TYPE format: (size 28)
    ## NEXT => 0
    ## SIZE => 4
    ## OFFSET => 8
    ## INDIRECT => 12
    ## MEMBERS => 16
    ## TYPE => 20
    ## NAME => 24
    ## Struct TOKEN_LIST format: (size 20)
    ## NEXT => 0
    ## LOCALS/PREV => 4
    ## S => 8
    ## TYPE => 12
    ## ARGS/DEPTH => 16
    ## Where the ELF Header is going to hit
    ## Simply jump to _start
    ## Our main function

:_start ; .text offset 0x0, vaddr 0x10054
    '04009DE4'    ; pop {r0}    # Get the number of arguments
    '04009DE4'    ; pop {r0}    # Get the program name
    '04009DE4'    ; pop {r0}    # Get the actual input name
    '0010A0E3'    ; mov r1, #0    # prepare read_only
    '0570A0E3'    ; mov r7, #5    # the syscall number for open()
    '000000EF'    ; svc #0    # Now open that damn file
    'E0869FE5'    ; ldr r8, Input_file_address
    '000088E5'    ; str r0, [r8]    # Preserve the file pointer we were given
    '04009DE4'    ; pop {r0}    # Get the actual output name
    '411200E3'    ; mov r1, #577    # Prepare file as O_WRONLY|O_CREAT|O_TRUNC
    '062DA0E3'    ; mov r2, #384    # Prepare file as RW for owner only (600 in octal)
    '0570A0E3'    ; mov r7, #5    # the syscall number for open()
    '000000EF'    ; svc #0    # Now open that damn file
    '000050E3'    ; cmp r0, #0    # Check for missing output
    ^~_start_out JUMP_GT    ; bgt _start_out    # Have real input
    '0100A0E3'    ; mov r0, #1    # Use stdout

:_start_out ; .text offset 0x40, vaddr 0x10094
    'B0879FE5'    ; ldr r8, Output_file_address
    '000088E5'    ; str r0, [r8]    # Preserve the file pointer we were given
    '2D70A0E3'    ; mov r7, #45    # the Syscall # for SYS_BRK
    '0000A0E3'    ; mov r0, #0    # Get current brk
    '000000EF'    ; svc #0    # Let the kernel do the work
    '00849FE5'    ; ldr r8, MALLOC_address
    '000088E5'    ; str r0, [r8]    # Set our malloc pointer
    '0000A0E3'    ; mov r0, #0    # HEAD = NULL
    '04E02DE5'    ; push {r14}
    ^~read_all_tokens CALL_ALWAYS    ; bl read_all_tokens    # Read all tokens
    ^~Reverse_List CALL_ALWAYS    ; bl Reverse_List    # Reverse order
    ## 	bl debug_list                       @ Try to figure out what is wrong
    '04E09DE4'    ; pop {r14}
    '04B19FE5'    ; ldr r11, function_address    # initialize r11
    'F4C09FE5'    ; ldr r12, global_token_address    # initialize r12
    '00008CE5'    ; str r0, [r12]    # Set global_token
    '04E02DE5'    ; push {r14}
    ^~program CALL_ALWAYS    ; bl program    # Convert into program
    '04E09DE4'    ; pop {r14}
    '80008FE2'    ; adr r0, header_string1    # Our header string
    '04E02DE5'    ; push {r14}
    ^~File_Print CALL_ALWAYS    ; bl File_Print    # Print it
    '04E09DE4'    ; pop {r14}
    'D4809FE5'    ; ldr r8, output_list_address_0
    '000098E5'    ; ldr r0, [r8]    # Our output_list
    '04E02DE5'    ; push {r14}
    ^~recursive_output CALL_ALWAYS    ; bl recursive_output    # Print core program
    '04E09DE4'    ; pop {r14}
    ## 	adr r0, header_string2              @ Our Enable debug
    ## 	bl File_Print                       @ Print it
    '7C008FE2'    ; adr r0, header_string3    # Our second label
    '04E02DE5'    ; push {r14}
    ^~File_Print CALL_ALWAYS    ; bl File_Print    # Print it
    '04E09DE4'    ; pop {r14}
    '048A9FE5'    ; ldr r8, globals_list_address
    '000098E5'    ; ldr r0, [r8]    # Our globals
    '04E02DE5'    ; push {r14}
    ^~recursive_output CALL_ALWAYS    ; bl recursive_output    # Get them
    '04E09DE4'    ; pop {r14}
    '78008FE2'    ; adr r0, header_string4    # Our final header
    '04E02DE5'    ; push {r14}
    ^~File_Print CALL_ALWAYS    ; bl File_Print    # Print it
    '04E09DE4'    ; pop {r14}
    '90809FE5'    ; ldr r8, strings_list_address_0
    '000098E5'    ; ldr r0, [r8]    # Our strings
    '04E02DE5'    ; push {r14}
    ^~recursive_output CALL_ALWAYS    ; bl recursive_output    # Get them
    '04E09DE4'    ; pop {r14}
    '68008FE2'    ; adr r0, header_string5    # Make this a bare assembly
    '04E02DE5'    ; push {r14}
    ^~File_Print CALL_ALWAYS    ; bl File_Print    # Print it
    '04E09DE4'    ; pop {r14}

:Done ; .text offset 0x104, vaddr 0x10158
    ## program completed Successfully
    '0000A0E3'    ; mov r0, #0    # All is well
    '0170A0E3'    ; mov r7, #1    # put the exit syscall number in r7
    '000000EF'    ; svc #0    # Call it a good day

:header_string1 ; .text offset 0x110, vaddr 0x10164
    '0A2320436F72652070726F6772616D0A00'    ; .asciz "\n# Core program\n"
    '0000A0'    ; .balign 4 padding

:header_string2 ; .text offset 0x124, vaddr 0x10178
    '0A3A454C465F646174610A00'    ; .asciz "\n:ELF_data\n"

:header_string3 ; .text offset 0x130, vaddr 0x10184
    '0A232050726F6772616D20676C6F62616C207661726961626C65730A00'    ; .asciz "\n# Program global variables\n"
    '0000A0'    ; .balign 4 padding

:header_string4 ; .text offset 0x150, vaddr 0x101a4
    '0A232050726F6772616D20737472696E67730A00'    ; .asciz "\n# Program strings\n"

:header_string5 ; .text offset 0x164, vaddr 0x101b8
    '0A3A454C465F656E640A00'    ; .asciz "\n:ELF_end\n"
    '00'    ; .balign 4 padding

:global_token_address ; .text offset 0x170, vaddr 0x101c4
    &global_token    ; .word global_token

:output_list_address_0 ; .text offset 0x174, vaddr 0x101c8
    &output_list    ; .word output_list

:strings_list_address_0 ; .text offset 0x178, vaddr 0x101cc
    &strings_list    ; .word strings_list

:function_address ; .text offset 0x17c, vaddr 0x101d0
    &function    ; .word function
    ## read_all_tokens function
    ## Receives Token_List* in R0
    ## Tokenizes all input and returns updated list in R0
    ## Returns TOKEN in R0
    ## Uses R0 for C

:read_all_tokens ; .text offset 0x180, vaddr 0x101d4
    '30809FE5'    ; ldr r8, Token_address
    '000088E5'    ; str r0, [r8]
    '04E02DE5'    ; push {r14}
    ^~fgetc CALL_ALWAYS    ; bl fgetc
    '04E09DE4'    ; pop {r14}

:read_all_tokens_loop ; .text offset 0x194, vaddr 0x101e8
    '040070E3'    ; cmp r0, #-4    # Check for EOF
    ^~read_all_tokens_done JUMP_EQUAL    ; beq read_all_tokens_done    # Stop if found
    '04E02DE5'    ; push {r14}
    ^~get_token CALL_ALWAYS    ; bl get_token    # Read all tokens
    '04E09DE4'    ; pop {r14}
    ^~read_all_tokens_loop JUMP_ALWAYS    ; b read_all_tokens_loop    # Loop

:read_all_tokens_done ; .text offset 0x1ac, vaddr 0x10200
    '04809FE5'    ; ldr r8, Token_address
    '000098E5'    ; ldr r0, [r8]
    '1EFF2FE1'    ; bx r14

:Token_address ; .text offset 0x1b8, vaddr 0x1020c
    &Token    ; .word Token
    ## get_token function
    ## Receives INT in R0
    ## Makes a list of TOKEN_LIST
    ## C and STRING_INDEX are stored in memory, R2 is used for S and R3 is used for current
    ## Returns C in R0

:get_token ; .text offset 0x1bc, vaddr 0x10210
    '04102DE5'    ; push {r1}    # Protect R1
    '04202DE5'    ; push {r2}    # Protect R2
    '04302DE5'    ; push {r3}    # Protect R3
    '48829FE5'    ; ldr r8, C_address
    '000088E5'    ; str r0, [r8]    # Set C
    '1400A0E3'    ; mov r0, #20    # Malloc CURRENT
    '04E02DE5'    ; push {r14}
    ^~malloc CALL_ALWAYS    ; bl malloc    # Get Pointer
    '04E09DE4'    ; pop {r14}
    '0030A0E1'    ; mov r3, r0    # Set CURRENT
    '010CA0E3'    ; mov r0, #256    # Malloc the string
    '04E02DE5'    ; push {r14}
    ^~malloc CALL_ALWAYS    ; bl malloc    # Get pointer to S
    '04E09DE4'    ; pop {r14}
    '0020A0E1'    ; mov r2, r0    # Set S
    '082083E5'    ; str r2, [r3, #8]    # CURRENT->S = S

:reset ; .text offset 0x1fc, vaddr 0x10250
    '74849FE5'    ; ldr r8, string_index_address
    '002088E5'    ; str r2, [r8]    # S[0]
    '0C829FE5'    ; ldr r8, C_address
    '000098E5'    ; ldr r0, [r8]    # Using C
    '04E02DE5'    ; push {r14}
    ^~clear_white_space CALL_ALWAYS    ; bl clear_white_space    # Clear WhiteSpace
    '04E09DE4'    ; pop {r14}
    'F8819FE5'    ; ldr r8, C_address
    '000088E5'    ; str r0, [r8]    # Set C
    '040070E3'    ; cmp r0, #-4    # Check for EOF
    ^~get_token_abort JUMP_EQUAL    ; beq get_token_abort    # if EOF abort
    '230050E3'    ; cmp r0, #35    # Check for '#'
    ^~get_token_alpha JUMP_NE    ; bne get_token_alpha    # Nope
    ## Deal with # line comments
    '04E02DE5'    ; push {r14}
    ^~purge_macro CALL_ALWAYS    ; bl purge_macro    # Let it handle it
    '04E09DE4'    ; pop {r14}
    'D4819FE5'    ; ldr r8, C_address
    '000088E5'    ; str r0, [r8]    # Set C
    ^~reset JUMP_ALWAYS    ; b reset    # Try again

:get_token_alpha ; .text offset 0x248, vaddr 0x1029c
    'C8819FE5'    ; ldr r8, C_address
    '000098E5'    ; ldr r0, [r8]    # Send C
    '0A1D8FE2'    ; adr r1, alphas    # Get alphanumerics
    '04E02DE5'    ; push {r14}
    ^~In_Set CALL_ALWAYS    ; bl In_Set    # See if in set
    '04E09DE4'    ; pop {r14}
    '010050E3'    ; cmp r0, #1    # IF TRUE
    ^~get_token_symbol JUMP_NE    ; bne get_token_symbol    # Otherwise
    ## Store keywords
    'A8819FE5'    ; ldr r8, C_address
    '000098E5'    ; ldr r0, [r8]    # Send C
    '04E02DE5'    ; push {r14}
    ^~preserve_keyword CALL_ALWAYS    ; bl preserve_keyword    # Store
    '04E09DE4'    ; pop {r14}
    '94819FE5'    ; ldr r8, C_address
    '000088E5'    ; str r0, [r8]    # Set C
    ^~get_token_done JUMP_ALWAYS    ; b get_token_done    # Be done with this token

:get_token_symbol ; .text offset 0x288, vaddr 0x102dc
    '88819FE5'    ; ldr r8, C_address
    '000098E5'    ; ldr r0, [r8]    # Send C
    '0A1D8FE2'    ; adr r1, symbols    # Get symbols
    '04E02DE5'    ; push {r14}
    ^~In_Set CALL_ALWAYS    ; bl In_Set    # See if in set
    '04E09DE4'    ; pop {r14}
    '010050E3'    ; cmp r0, #1    # IF TRUE
    ^~get_token_strings JUMP_NE    ; bne get_token_strings    # Otherwise
    ## Store symbols
    '68819FE5'    ; ldr r8, C_address
    '000098E5'    ; ldr r0, [r8]    # Send C
    '04E02DE5'    ; push {r14}
    ^~preserve_symbol CALL_ALWAYS    ; bl preserve_symbol    # Store
    '04E09DE4'    ; pop {r14}
    '54819FE5'    ; ldr r8, C_address
    '000088E5'    ; str r0, [r8]    # Set C
    ^~get_token_done JUMP_ALWAYS    ; b get_token_done    # Be done with this token

:get_token_strings ; .text offset 0x2c8, vaddr 0x1031c
    '48819FE5'    ; ldr r8, C_address
    '000098E5'    ; ldr r0, [r8]    # Send C
    '921F8FE2'    ; adr r1, strings    # Get strings
    '04E02DE5'    ; push {r14}
    ^~In_Set CALL_ALWAYS    ; bl In_Set    # See if in set
    '04E09DE4'    ; pop {r14}
    '010050E3'    ; cmp r0, #1    # IF TRUE
    ^~get_token_comment JUMP_NE    ; bne get_token_comment    # Otherwise
    ## Store String
    '28819FE5'    ; ldr r8, C_address
    '000098E5'    ; ldr r0, [r8]    # Send C
    '04E02DE5'    ; push {r14}
    ^~consume_word CALL_ALWAYS    ; bl consume_word    # Store
    '04E09DE4'    ; pop {r14}
    '14819FE5'    ; ldr r8, C_address
    '000088E5'    ; str r0, [r8]    # Set C
    ^~get_token_done JUMP_ALWAYS    ; b get_token_done    # Be done with this token

:get_token_comment ; .text offset 0x308, vaddr 0x1035c
    '08819FE5'    ; ldr r8, C_address
    '000098E5'    ; ldr r0, [r8]    # Send C
    '2F0050E3'    ; cmp r0, #47    # IF '/' == C
    ^~get_token_else JUMP_NE    ; bne get_token_else    # Otherwise
    '04E02DE5'    ; push {r14}
    ^~consume_byte CALL_ALWAYS    ; bl consume_byte    # Hope it just is '/'
    '04E09DE4'    ; pop {r14}
    'EC809FE5'    ; ldr r8, C_address
    '000088E5'    ; str r0, [r8]    # Set C
    '2A0050E3'    ; cmp r0, #42    # IF '*' we have "/*"
    ^~get_token_comment_line JUMP_NE    ; bne get_token_comment_line    # Check for '//'
    ## Deal with /* block comments */
    '04E02DE5'    ; push {r14}
    ^~fgetc CALL_ALWAYS    ; bl fgetc    # get next C
    '04E09DE4'    ; pop {r14}
    'D0809FE5'    ; ldr r8, C_address
    '000088E5'    ; str r0, [r8]    # Set C

:get_token_comment_block_outer ; .text offset 0x348, vaddr 0x1039c
    'C8809FE5'    ; ldr r8, C_address
    '000098E5'    ; ldr r0, [r8]    # Using C
    '2F0050E3'    ; cmp r0, #47    # IF '/' != C
    ^~get_token_comment_block_done JUMP_EQUAL    ; beq get_token_comment_block_done    # be done

:get_token_comment_block_inner ; .text offset 0x358, vaddr 0x103ac
    'B8809FE5'    ; ldr r8, C_address
    '000098E5'    ; ldr r0, [r8]    # Using C
    '2A0050E3'    ; cmp r0, #42    # IF '*' != C
    ^~get_token_comment_block_iter JUMP_EQUAL    ; beq get_token_comment_block_iter    # jump over
    ## Deal with inner loop
    '04E02DE5'    ; push {r14}
    ^~fgetc CALL_ALWAYS    ; bl fgetc    # get next C
    '04E09DE4'    ; pop {r14}
    '9C809FE5'    ; ldr r8, C_address
    '000088E5'    ; str r0, [r8]    # Set C
    ^~get_token_comment_block_inner JUMP_ALWAYS    ; b get_token_comment_block_inner    # keep going

:get_token_comment_block_iter ; .text offset 0x380, vaddr 0x103d4
    '04E02DE5'    ; push {r14}
    ^~fgetc CALL_ALWAYS    ; bl fgetc    # get next C
    '04E09DE4'    ; pop {r14}
    '84809FE5'    ; ldr r8, C_address
    '000088E5'    ; str r0, [r8]    # Set C
    ^~get_token_comment_block_outer JUMP_ALWAYS    ; b get_token_comment_block_outer

:get_token_comment_block_done ; .text offset 0x398, vaddr 0x103ec
    '04E02DE5'    ; push {r14}
    ^~fgetc CALL_ALWAYS    ; bl fgetc    # get next C
    '04E09DE4'    ; pop {r14}
    '6C809FE5'    ; ldr r8, C_address
    '000088E5'    ; str r0, [r8]    # Set C
    ^~reset JUMP_ALWAYS    ; b reset    # throw away, try again

:get_token_comment_line ; .text offset 0x3b0, vaddr 0x10404
    '2F0050E3'    ; cmp r0, #47    # IF '/' we have //
    ^~get_token_done JUMP_NE    ; bne get_token_done    # keep if just '/'
    ## Deal with // line comment
    '04E02DE5'    ; push {r14}
    ^~purge_macro CALL_ALWAYS    ; bl purge_macro    # discard all until newline
    '04E09DE4'    ; pop {r14}
    '4C809FE5'    ; ldr r8, C_address
    '000088E5'    ; str r0, [r8]    # Set C
    ^~reset JUMP_ALWAYS    ; b reset    # throw away, try again

:get_token_else ; .text offset 0x3d0, vaddr 0x10424
    '40809FE5'    ; ldr r8, C_address
    '000098E5'    ; ldr r0, [r8]    # Send C
    '04E02DE5'    ; push {r14}
    ^~consume_byte CALL_ALWAYS    ; bl consume_byte
    '04E09DE4'    ; pop {r14}
    '2C809FE5'    ; ldr r8, C_address
    '000088E5'    ; str r0, [r8]    # Set C

:get_token_done ; .text offset 0x3ec, vaddr 0x10440
    '3C821FE5'    ; ldr r8, Token_address
    '000098E5'    ; ldr r0, [r8]    # TOKEN
    '040083E5'    ; str r0, [r3, #4]    # CURRENT->PREV = TOKEN
    '000083E5'    ; str r0, [r3]    # CURRENT->NEXT = TOKEN
    '003088E5'    ; str r3, [r8]    # TOKEN = CURRENT

:get_token_abort ; .text offset 0x400, vaddr 0x10454
    '04309DE4'    ; pop {r3}    # Restore R3
    '04209DE4'    ; pop {r2}    # Restore R2
    '04109DE4'    ; pop {r1}    # Restore R1
    '04809FE5'    ; ldr r8, C_address
    '000098E5'    ; ldr r0, [r8]    # Return C
    '1EFF2FE1'    ; bx r14

:C_address ; .text offset 0x418, vaddr 0x1046c
    &C    ; .word C
    ## Malloc isn't actually required if the program being built fits in the initial memory
    ## However, it doesn't take much to add it.
    ## Requires [MALLOC] to be initialized and R0 to have the number of desired bytes

:malloc ; .text offset 0x41c, vaddr 0x10470
    '04102DE5'    ; push {r1}    # Protect R1
    '04202DE5'    ; push {r2}    # Protect R2
    '04302DE5'    ; push {r3}    # Protect R3
    '2C809FE5'    ; ldr r8, MALLOC_address
    '001098E5'    ; ldr r1, [r8]    # Using the current pointer
    '010080E0'    ; add r0, r1    # Request the number of desired bytes
    '2D70A0E3'    ; mov r7, #45    # the Syscall # for SYS_BRK
    '000000EF'    ; svc #0    # call the Kernel
    '18809FE5'    ; ldr r8, MALLOC_address
    '001098E5'    ; ldr r1, [r8]
    '000088E5'    ; str r0, [r8]    # Update pointer
    '0100A0E1'    ; mov r0, r1    # Return pointer
    '04309DE4'    ; pop {r3}    # Restore R3
    '04209DE4'    ; pop {r2}    # Restore R2
    '04109DE4'    ; pop {r1}    # Restore R1
    '1EFF2FE1'    ; bx r14

:MALLOC_address ; .text offset 0x45c, vaddr 0x104b0
    &MALLOC    ; .word MALLOC
    ## clear_white_space function
    ## Receives INT C in R0
    ## Returns first non-whitespace char in R0

:clear_white_space ; .text offset 0x460, vaddr 0x104b4
    '200050E3'    ; cmp r0, #32    # Check for ' '
    ^~clear_white_space_wipe JUMP_EQUAL    ; beq clear_white_space_wipe    # wipe it out
    '0A0050E3'    ; cmp r0, #10    # Check for '\n'
    ^~clear_white_space_wipe JUMP_EQUAL    ; beq clear_white_space_wipe    # wipe it out
    '090050E3'    ; cmp r0, #9    # Check for '\t'
    ^~clear_white_space_done JUMP_NE    ; bne clear_white_space_done    # looks like non-whitespace

:clear_white_space_wipe ; .text offset 0x478, vaddr 0x104cc
    '04E02DE5'    ; push {r14}
    ^~fgetc CALL_ALWAYS    ; bl fgetc    # Read a new byte
    '04E09DE4'    ; pop {r14}
    '040070E3'    ; cmp r0, #-4    # Check for EOF
    ^~clear_white_space_done JUMP_EQUAL    ; beq clear_white_space_done    # Short circuit
    ^~clear_white_space JUMP_ALWAYS    ; b clear_white_space    # iterate

:clear_white_space_done ; .text offset 0x490, vaddr 0x104e4
    '1EFF2FE1'    ; bx r14
    ## In_Set function
    ## Receives Char C in R0 and CHAR* in R1
    ## Returns 1 if true, zero if false in R0

:In_Set ; .text offset 0x494, vaddr 0x104e8
    '04102DE5'    ; push {r1}    # Protect R1
    '04202DE5'    ; push {r2}    # Protect R2

:In_Set_loop ; .text offset 0x49c, vaddr 0x104f0
    '0020D1E5'    ; ldrb r2, [r1]    # Read char
    '020050E1'    ; cmp r0, r2    # See if they match
    ^~In_Set_True JUMP_EQUAL    ; beq In_Set_True    # return true
    '000052E3'    ; cmp r2, #0    # Check for NULL
    ^~In_Set_False JUMP_EQUAL    ; beq In_Set_False    # return false
    '011081E2'    ; add r1, #1    # s = s + 1
    ^~In_Set_loop JUMP_ALWAYS    ; b In_Set_loop    # Keep looping

:In_Set_True ; .text offset 0x4b8, vaddr 0x1050c
    '0100A0E3'    ; mov r0, #1    # Set True
    '04209DE4'    ; pop {r2}    # Restore R2
    '04109DE4'    ; pop {r1}    # Restore R1
    '1EFF2FE1'    ; bx r14

:In_Set_False ; .text offset 0x4c8, vaddr 0x1051c
    '0000A0E3'    ; mov r0, #0    # Set FALSE
    '04209DE4'    ; pop {r2}    # Restore R2
    '04109DE4'    ; pop {r1}    # Restore R1
    '1EFF2FE1'    ; bx r14

