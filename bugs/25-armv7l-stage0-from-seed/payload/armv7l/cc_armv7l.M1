    '0A80A0E3'    ; mov r8, #10
    '900800E0'    ; mul r0, r8    # VALUE = VALUE * 10
    '302042E2'    ; sub r2, #48    # CH = CH - '0'
    '090052E3'    ; cmp r2, #9    # Check for illegal
    ^~numerate_string_fail JUMP_GT    ; bgt numerate_string_fail    # If CH > '9'
    '000052E3'    ; cmp r2, #0    # Check for illegal
    ^~numerate_string_fail JUMP_LT    ; blt numerate_string_fail    # IF CH < 0
    '020080E0'    ; add r0, r2    # VALUE = VALUE + CH
    '011081E2'    ; add r1, #1    # S = S + 1
