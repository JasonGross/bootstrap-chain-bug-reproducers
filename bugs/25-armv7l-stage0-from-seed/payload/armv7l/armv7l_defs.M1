## armv7l stage0-cc macro definitions (the cc-OUTPUT vocabulary).
## GENERATED by scripts/gen-cc-defs.py from GAS/cc_macros_armv7l.S:
## every 8-hex value below is the clang-14 A32 encoding of the
## instruction named in its comment.  DO NOT hand-edit values —
## edit the .S and regenerate.  This is the stage0-cc LAYER, a
## deliberately different vocabulary from M2libc/armv7l/armv7l_defs.M1
## (M2-Planet's layer); see this entry's run.sh header for the layering and
## why each choice was a choice.

DEFINE PUSH_R0 04002DE5	; push {r0}
DEFINE PUSH_R1 04102DE5	; push {r1}
DEFINE PUSH_R2 04202DE5	; push {r2}
DEFINE PUSH_R3 04302DE5	; push {r3}
DEFINE PUSH_BP 04C02DE5	; push {r12}
DEFINE PUSH_LR 04E02DE5	; push {lr}
DEFINE POP_R0 04009DE4	; pop {r0}
DEFINE POP_R1 04109DE4	; pop {r1}
DEFINE POP_R2 04209DE4	; pop {r2}
DEFINE POP_R3 04309DE4	; pop {r3}
DEFINE POP_BP 04C09DE4	; pop {r12}
DEFINE POP_LR 04E09DE4	; pop {lr}
DEFINE MOVE_R1_FROM_R0 0010A0E1	; mov r1, r0
DEFINE MOVE_R0_FROM_R1 0100A0E1	; mov r0, r1
DEFINE MOVE_R2_FROM_R0 0020A0E1	; mov r2, r0
DEFINE MOVE_R0_FROM_BP 0C00A0E1	; mov r0, r12
DEFINE MOVE_R3_FROM_SP 0D30A0E1	; mov r3, sp
DEFINE MOVE_BP_FROM_R3 03C0A0E1	; mov r12, r3
DEFINE MOVE_BP_FROM_SP 0DC0A0E1	; mov r12, sp
DEFINE LOAD_R0_AHEAD 00009FE5	; ldr r0, [pc]
DEFINE LOAD_R1_AHEAD 00109FE5	; ldr r1, [pc]
DEFINE LOAD_R2_AHEAD 00209FE5	; ldr r2, [pc]
DEFINE SKIP_32_DATA 000000EA	; b . + 8
DEFINE LOAD_INTEGER 000090E5	; ldr r0, [r0]
DEFINE LOAD_BYTE 0000D0E5	; ldrb r0, [r0]
DEFINE STORE_INTEGER 000081E5	; str r0, [r1]
DEFINE STORE_CHAR 0000C1E5	; strb r0, [r1]
DEFINE SET_R0_TO_0 0000A0E3	; mov r0, #0
DEFINE SET_R0_TO_1 0100A0E3	; mov r0, #1
DEFINE ADD_R0_R1 010080E0	; add r0, r0, r1
DEFINE ADD_R0_SP_4 04008DE2	; add r0, sp, #4
DEFINE ADD_R0_2 020080E2	; add r0, r0, #2
DEFINE ADD_R0_BP 0C0080E0	; add r0, r0, r12
DEFINE ADD_BP_4 04C08CE2	; add r12, r12, #4
DEFINE SUB_R0_R1_R0 000041E0	; sub r0, r1, r0
