DEFINE XOR_R0_R1 010020E0	; eor r0, r0, r1
DEFINE NOT_R0 0000E0E1	; mvn r0, r0
DEFINE LSL2_R0 0001A0E1	; mov r0, r0, lsl #2
DEFINE LSHIFT_R0_BY_R2 1002A0E1	; mov r0, r0, lsl r2
DEFINE ARITH_RSHIFT_R0_BY_R2 5002A0E1	; mov r0, r0, asr r2
DEFINE LOAD_R0_FROM_BP 00009CE5	; ldr r0, [r12]
DEFINE TEST 000050E3	; cmp r0, #0
DEFINE CMP_R1_R0 000051E1	; cmp r1, r0
DEFINE SET_R0_TO_1_EQ 0100A003	; moveq r0, #1
DEFINE SET_R0_TO_1_NE 0100A013	; movne r0, #1
DEFINE SET_R0_TO_1_LT 0100A0B3	; movlt r0, #1
DEFINE SET_R0_TO_1_LE 0100A0D3	; movle r0, #1
DEFINE SET_R0_TO_1_GT 0100A0C3	; movgt r0, #1
DEFINE SET_R0_TO_1_GE 0100A0A3	; movge r0, #1
DEFINE CALL_R0 30FF2FE1	; blx r0
DEFINE RETURN 1EFF2FE1	; bx lr
DEFINE SET_R7_TO_1 0170A0E3	; mov r7, #1
DEFINE SYSCALL 000000EF	; svc #0

## hex2 '^~label BYTE' branch opcode bytes (the byte that
## completes the 3-byte imm24 field into an A32 word):
DEFINE JUMP_EQ 0A	; beq  — cond 0000, b
DEFINE JUMP_NE 1A	; bne  — cond 0001, b
DEFINE JUMP EA	; b    — cond 1110 (always), b
DEFINE CALL_IMMEDIATE EB	; bl   — cond 1110 (always), bl
DEFINE NULL 00000000	; 32-bit zero data cell (one word per global)

