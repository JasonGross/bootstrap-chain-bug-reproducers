## armv7l top-level driver (mirrors kaem.x86 / kaem.aarch64).
## Run from the stage0-posix root with ONLY the 460-byte armv7l hex0 seed
## and the 1,162-byte kaem seed as pre-existing binaries:
##
##     ./bootstrap-seeds/POSIX/armv7l/kaem-optional-seed ./kaem.armv7l
##
## Everything below is built by the line above it.

./bootstrap-seeds/POSIX/armv7l/kaem-optional-seed ./armv7l/mescc-tools-seed-kaem.kaem
./armv7l/artifact/kaem-0 ./armv7l/mescc-tools-mini-kaem.kaem
./armv7l/bin/kaem --verbose --strict --file ./armv7l/kaem.run
