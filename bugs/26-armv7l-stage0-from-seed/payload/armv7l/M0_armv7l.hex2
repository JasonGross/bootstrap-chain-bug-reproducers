:Input ; .text offset 0x94c, vaddr 0x109a0

:Output ; .text offset 0x94c, vaddr 0x109a0

## literal pool: absolute addresses of the data cells, computed by the
## hex2 linker from the labels below — .text offset 0x94c, vaddr 0x109a0
:Input_address
    &Input    ; .word Input (== 0x109a8)
:Output_address
    &Output    ; .word Output (== 0x109ac)

## data cells (vaddr 0x109a8); heap lives past the file on brk
:Input
    00000000
:Output
    00000000

## ---------------------------------------------------------------------
## armv7l '~' numeric-immediate extension (S6, 2026-07-27). The M2libc
## armv7l M1 layer writes its skip-32-data idiom as `~0 JUMP_ALWAYS`
## (3-byte imm24 + 1-byte cond EA = `b .+8`), so M0 must give '~' a
## 24-bit width — M1-macro.c ARMV7L parity ('~' == 3 bytes, little-
## endian).  The x86 reference M0 has no '~' (x86 M1 never uses it) and
## upstream never ran an armv7l mini-kaem, so this width exists in no
## upstream M0; without it `~0` numerates at 8 bits and every M2-Planet-
## emitted global load loses 2 bytes (misaligned labels, dead branches).
## Appended AFTER the data cells so no existing offset, literal-pool
## displacement, or baked branch word moves; reached via the retargeted
## bne in express_number2; branches here are symbolic ^~ (the S5a
## hex2-0-armv7l aligned form), not baked words.

:M0_tilde_check
    7E0052E3    ; cmp r2, #126    # IF '~' == CH
    ^~express_number1 1A    ; bne express_number1    # Otherwise 8-bit default
    0700A0E3    ; mov r0, #7    # We need 7 bytes (6 hex + null)
    04E02DE5    ; push {r14}
    ^~malloc EB    ; bl malloc    # Get S pointer
    04E09DE4    ; pop {r14}
    0080A0E1    ; mov r8, r0
    0100A0E1    ; mov r0, r1    # Put S and VALUE in place
    0810A0E1    ; mov r1, r8
    04102DE5    ; push {r1}    # Protect S
    04E02DE5    ; push {r14}
    ^~hex24l EB    ; bl hex24l    # Store 24bits
    04E09DE4    ; pop {r14}
    ^~express_number_done EA    ; b express_number_done    # done

## hex24l: 3 bytes little-endian (low 16 via hex16l, then the top byte);
## hex8's final bx r14 returns to OUR caller (r14 restored before the
## tail branch), mirroring the hex32l/hex16l chaining style.
:hex24l
    04002DE5    ; push {r0}    # Protect top byte
    04E02DE5    ; push {r14}
    ^~hex16l EB    ; bl hex16l    # Store low 16 first
    04E09DE4    ; pop {r14}
    04009DE4    ; pop {r0}    # do top byte
    4008A0E1    ; asr r0, #16    # shift it down
    ^~hex8 EA    ; b hex8    # store it (tail; returns to caller)

:ELF_end
