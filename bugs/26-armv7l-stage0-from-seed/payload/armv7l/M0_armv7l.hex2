## M0_armv7l: hand-assembled A32 rendering of stage0-posix-armv7l's
## GAS/M0_x86.S reference (ARM code under an x86 filename), instruction for
## instruction. M0 is the minimal macro assembler: 'DEFINE name value'
## macros, token substitution, raw ('...') and hexified ("...") strings,
## and immediates — %N emits 32-bit little-endian hex, @N emits 16-bit,
## anything else 8-bit; decimal, 0x-hex and negative values accepted.
## Usage: ./M0 <input.M1> <output.hex2>
##
## This file is written in the hex2 LANGUAGE and carries no ELF header of
## its own: the ladder concatenates ELF-armv7l.hex2 (which ends at
## :ELF_text) in front of it with catm, then links with hex2-0 — exactly
## the x86 M0_x86.hex2 arrangement. The literal pool uses '&' absolutes
## computed by the linker; the file ends with :ELF_end for the header's
## size fields.

## Where the ELF Header is going to hit
## Simply jump to _start
## Our main function
    ## Register usage:
    ## R0, R2, R1 => Temps
    ## R5 => MALLOC
    ## R6 => HEAD
    ## [Output] => Output_file
    ## [Input] => Input_file
    ## Struct format: (size 32)
    ## NEXT => 0
    ## TYPE => 8
    ## TEXT => 16
    ## EXPRESSION => 24
    ## Types
    ## None => 0
    ## MACRO => 1
    ## STRING => 2
    ## Where the ELF Header is going to hit
    ## Simply jump to _start
    ## Our main function

:_start ; .text offset 0x0, vaddr 0x10054
    04009DE4    ; pop {r0}    # Get the number of arguments
    04009DE4    ; pop {r0}    # Get the program name
    04009DE4    ; pop {r0}    # Get the actual input name
    0010A0E3    ; mov r1, #0    # prepare read_only
    0570A0E3    ; mov r7, #5    # the syscall number for open()
    000000EF    ; svc #0    # Now open that damn file
    2C899FE5    ; ldr r8, Input_address
    000088E5    ; str r0, [r8]    # Preserve the file pointer we were given
    04009DE4    ; pop {r0}    # Get the actual output name
    411200E3    ; mov r1, #577    # Prepare file as O_WRONLY|O_CREAT|O_TRUNC
    062DA0E3    ; mov r2, #384    # Prepare file as RW for owner only (600 in octal)
    0570A0E3    ; mov r7, #5    # the syscall number for open()
    000000EF    ; svc #0    # Now open that damn file
    000050E3    ; cmp r0, #0    # Check for missing output
    000000CA    ; bgt _start_out    # Have real input
    0100A0E3    ; mov r0, #1    # Use stdout

:_start_out ; .text offset 0x40, vaddr 0x10094
    08899FE5    ; ldr r8, Output_address
    000088E5    ; str r0, [r8]    # Preserve the file pointer we were given
    2D70A0E3    ; mov r7, #45    # the Syscall # for SYS_BRK
    0000A0E3    ; mov r0, #0    # Get current brk
    000000EF    ; svc #0    # Let the kernel do the work
    0050A0E1    ; mov r5, r0    # Set our malloc pointer
    04E02DE5    ; push {r14}
    0C0000EB    ; bl Tokenize_Line    # Get all lines
    0600A0E1    ; mov r0, r6    # prepare for Reverse_List
    A00000EB    ; bl Reverse_List    # Correct order
    0060A0E1    ; mov r6, r0    # Update HEAD
    AC0000EB    ; bl Identify_Macros    # Find the DEFINEs
    E10000EB    ; bl Line_Macro    # Apply the DEFINEs
    0D0100EB    ; bl Process_String    # Handle strings
    470100EB    ; bl Eval_Immediates    # Handle Numbers
    F00100EB    ; bl Preserve_Other    # Collect the remaining
    000200EB    ; bl Print_Hex    # Output our results
    04E09DE4    ; pop {r14}

:Done ; .text offset 0x88, vaddr 0x100dc
    ## program completed Successfully
    0000A0E3    ; mov r0, #0    # All is well
    0170A0E3    ; mov r7, #1    # put the exit syscall number in r7
    000000EF    ; svc #0    # Call it a good day
    ## Tokenize_Line Function
    ## Using input file [Input] and Head R6
    ## Creates a linked list of structs
    ## Uses R1 for in_set strings, R2 for Int C and R3 for Struct Token* p

:Tokenize_Line ; .text offset 0x94, vaddr 0x100e8
    04102DE5    ; push {r1}    # Protect R1
    04202DE5    ; push {r2}    # Protect R2
    04302DE5    ; push {r3}    # Protect R3

:restart ; .text offset 0xa0, vaddr 0x100f4
    04E02DE5    ; push {r14}
    240000EB    ; bl fgetc    # Read a char
    04E09DE4    ; pop {r14}
    040070E3    ; cmp r0, #-4    # Check for EOF
    1D00000A    ; beq done    # File is collected
    0020A0E1    ; mov r2, r0    # Protect C
    891F8FE2    ; adr r1, comments    # Get pointer to "#;"
    04E02DE5    ; push {r14}
    750000EB    ; bl In_Set    # Check for comments
    04E09DE4    ; pop {r14}
    010050E3    ; cmp r0, #1    # If comments
    3900000A    ; beq Purge_LineComment    # try again
    0200A0E1    ; mov r0, r2    # put C in place for check
    811F8FE2    ; adr r1, terminators    # Get pointer to "\n\t "
    04E02DE5    ; push {r14}
    6E0000EB    ; bl In_Set    # Check for terminators
    04E09DE4    ; pop {r14}
    010050E3    ; cmp r0, #1    # If terminator
    ECFFFF0A    ; beq restart    # try again
    2000A0E3    ; mov r0, #32    # Malloc the struct P
    04E02DE5    ; push {r14}
    220000EB    ; bl malloc    # Get pointer to P
    0030A0E1    ; mov r3, r0    # Protect P
    006083E5    ; str r6, [r3]    # P->NEXT = HEAD
    0360A0E1    ; mov r6, r3    # HEAD = P
    0200A0E1    ; mov r0, r2    # put C in place for check
    761F8FE2    ; adr r1, string_char    # Get pointer to "\"'"
    620000EB    ; bl In_Set    # Check for string chars
    04E09DE4    ; pop {r14}
    010050E3    ; cmp r0, #1    # If string char
    2C00000A    ; beq Store_String    # Get string
    04E02DE5    ; push {r14}
    430000EB    ; bl Store_Atom    # Get whole token
    04E09DE4    ; pop {r14}
    DCFFFFEA    ; b restart

:done ; .text offset 0x12c, vaddr 0x10180
    04309DE4    ; pop {r3}    # Restore R3
    04209DE4    ; pop {r2}    # Restore R2
    04109DE4    ; pop {r1}    # Restore R1
    1EFF2FE1    ; bx r14
    ## fgetc function
    ## Receives FILE* in [Input]
    ## Returns -4 (EOF) or char in R0

:fgetc ; .text offset 0x13c, vaddr 0x10190
    04302DE5    ; push {r3}    # Protect R3
    04202DE5    ; push {r2}    # Protect R2
    04102DE5    ; push {r1}    # Protect R1
    0300E0E3    ; mov r0, #-4    # Put EOF in r0
    04002DE5    ; push {r0}    # Assume bad (If nothing read, value will remain EOF)
    0D10A0E1    ; mov r1, r13    # Get stack address
    F0879FE5    ; ldr r8, Input_address
    000098E5    ; ldr r0, [r8]    # Where are we reading from
    0370A0E3    ; mov r7, #3    # the syscall number for read
    0120A0E3    ; mov r2, #1    # set the size of chars we want
    000000EF    ; svc #0    # call the Kernel
    04009DE4    ; pop {r0}    # Get either char or EOF
    040070E3    ; cmp r0, #-4
    FF000012    ; andne r0, #0xFF
    04109DE4    ; pop {r1}    # Restore R1
    04209DE4    ; pop {r2}    # Restore R2
    04309DE4    ; pop {r3}    # Restore R3
    1EFF2FE1    ; bx r14
    ## Malloc isn't actually required if the program being built fits in the initial memory
    ## However, it doesn't take much to add it.
    ## Requires R5 to be initialized and R0 to have the number of desired bytes

:malloc ; .text offset 0x184, vaddr 0x101d8
    04302DE5    ; push {r3}    # Protect R3
    04202DE5    ; push {r2}    # Protect R2
    04102DE5    ; push {r1}    # Protect R1
    0510A0E1    ; mov r1, r5    # Using the current pointer
    050080E0    ; add r0, r5    # Request the number of desired bytes
    2D70A0E3    ; mov r7, #45    # the Syscall # for SYS_BRK
    000000EF    ; svc #0    # call the Kernel
    0050A0E1    ; mov r5, r0    # Update pointer
    0100A0E1    ; mov r0, r1    # Return pointer
    04109DE4    ; pop {r1}    # Restore R1
    04209DE4    ; pop {r2}    # Restore R2
    04309DE4    ; pop {r3}    # Restore R3
    1EFF2FE1    ; bx r14
    ## Purge_LineComment function
    ## Reads chars until LF and jumps to restart

:Purge_LineComment ; .text offset 0x1b8, vaddr 0x1020c
    04E02DE5    ; push {r14}
    DEFFFFEB    ; bl fgetc    # Get a char
    04E09DE4    ; pop {r14}
    0A0050E3    ; cmp r0, #10    # While not LF
    FAFFFF1A    ; bne Purge_LineComment    # Keep reading
    B3FFFFEA    ; b restart
    ## Store_String Function
    ## Receives C in R2, HEAD in R3 and Input file in [Output]
    ## Uses R1 for terminator, R2 for C and R3 for string

:Store_String ; .text offset 0x1d0, vaddr 0x10224
    04102DE5    ; push {r1}    # Protect R1
    04202DE5    ; push {r2}    # Protect R2
    04302DE5    ; push {r3}    # Protect R3
    0200A0E3    ; mov r0, #2    # Using TYPE STRING
    080083E5    ; str r0, [r3, #8]    # HEAD->TYPE = STRING
    010CA0E3    ; mov r0, #256    # Malloc the string
    04E02DE5    ; push {r14}
    E4FFFFEB    ; bl malloc    # Get pointer to P
    04E09DE4    ; pop {r14}
    100083E5    ; str r0, [r3, #16]    # HEAD->TEXT = STRING
    0210A0E1    ; mov r1, r2    # Protect terminator
    0030A0E1    ; mov r3, r0    # Protect string pointer

:Store_String_Loop ; .text offset 0x200, vaddr 0x10254
    0020C3E5    ; strb r2, [r3]    # write byte
    04E02DE5    ; push {r14}
    CBFFFFEB    ; bl fgetc    # read next char
    04E09DE4    ; pop {r14}
    0020A0E1    ; mov r2, r0    # Update C
    013083E2    ; add r3, #1    # STRING = STRING + 1
    010052E1    ; cmp r2, r1    # See if we hit terminator
    F7FFFF1A    ; bne Store_String_Loop    # Otherwise keep looping
    04309DE4    ; pop {r3}    # Restore R3
    04209DE4    ; pop {r2}    # Restore R2
    04109DE4    ; pop {r1}    # Restore R1
    0300A0E1    ; mov r0, r3    # return HEAD
    9AFFFFEA    ; b restart
    ## Store_Atom Function
    ## Receives C in R2, HEAD in R3 and Input file in [Input]
    ## Uses R1 for in_set strings, R2 for C and R3 for string

:Store_Atom ; .text offset 0x234, vaddr 0x10288
    04102DE5    ; push {r1}    # Protect R1
    04202DE5    ; push {r2}    # Protect R2
    04302DE5    ; push {r3}    # Protect R3
    010CA0E3    ; mov r0, #256    # Malloc the string
    04E02DE5    ; push {r14}
    CDFFFFEB    ; bl malloc    # Get pointer to P
    04E09DE4    ; pop {r14}
    100083E5    ; str r0, [r3, #16]    # HEAD->TEXT = STRING
    84108FE2    ; adr r1, terminators    # Get pointer to "\n\t "
    0030A0E1    ; mov r3, r0    # Protect string pointer

:Store_Atom_loop ; .text offset 0x25c, vaddr 0x102b0
    0020C3E5    ; strb r2, [r3]    # write byte
    04E02DE5    ; push {r14}
    B4FFFFEB    ; bl fgetc    # read next char
    04E09DE4    ; pop {r14}
    0020A0E1    ; mov r2, r0    # Update C
    013083E2    ; add r3, #1    # STRING = STRING + 1
    04E02DE5    ; push {r14}
    070000EB    ; bl In_Set    # Check for terminators
    04E09DE4    ; pop {r14}
    000050E3    ; cmp r0, #0    # Check for "\n\t "
    F4FFFF0A    ; beq Store_Atom_loop    # Loop otherwise
    04309DE4    ; pop {r3}    # Restore R3
    04209DE4    ; pop {r2}    # Restore R2
    04109DE4    ; pop {r1}    # Restore R1
    0300A0E1    ; mov r0, r3    # return HEAD
    1EFF2FE1    ; bx r14
    ## In_Set function
    ## Receives Char C in R0 and CHAR* in R1
    ## Returns 1 if true, zero if false in R0

:In_Set ; .text offset 0x29c, vaddr 0x102f0
    04102DE5    ; push {r1}    # Protect R1
    04202DE5    ; push {r2}    # Protect R2

:In_Set_loop ; .text offset 0x2a4, vaddr 0x102f8
    0020D1E5    ; ldrb r2, [r1]    # Read char
    020050E1    ; cmp r0, r2    # See if they match
    0300000A    ; beq In_Set_True    # return true
    000052E3    ; cmp r2, #0    # Check for NULL
    0500000A    ; beq In_Set_False    # return false
    011081E2    ; add r1, #1    # s = s + 1
    F8FFFFEA    ; b In_Set_loop    # Keep looping

:In_Set_True ; .text offset 0x2c0, vaddr 0x10314
    0100A0E3    ; mov r0, #1    # Set True
    04209DE4    ; pop {r2}    # Restore R2
    04109DE4    ; pop {r1}    # Restore R1
    1EFF2FE1    ; bx r14

:In_Set_False ; .text offset 0x2d0, vaddr 0x10324
    0000A0E3    ; mov r0, #0    # Set FALSE
    04209DE4    ; pop {r2}    # Restore R2
    04109DE4    ; pop {r1}    # Restore R1
    1EFF2FE1    ; bx r14
    ## Char sets

:terminators ; .text offset 0x2e0, vaddr 0x10334
    0A 09 20 00    ; .byte 10, 9, 32, 0

:comments ; .text offset 0x2e4, vaddr 0x10338
    23 3B 00 00    ; .byte 35, 59, 0, 0

:string_char ; .text offset 0x2e8, vaddr 0x1033c
    22 27 00 00    ; .byte 34, 39, 0, 0
    ## Reverse_List function
    ## Receives List in R0
    ## Returns the list reversed in R0

:Reverse_List ; .text offset 0x2ec, vaddr 0x10340
    04102DE5    ; push {r1}    # Protect R1
    04202DE5    ; push {r2}    # Protect R2
    0010A0E1    ; mov r1, r0    # Set HEAD
    0000A0E3    ; mov r0, #0    # ROOT = NULL

:Reverse_List_Loop ; .text offset 0x2fc, vaddr 0x10350
    000051E3    ; cmp r1, #0    # WHILE HEAD != NULL
    0400000A    ; beq Reverse_List_Done    # Stop otherwise
    002091E5    ; ldr r2, [r1]    # NEXT = HEAD->NEXT
    000081E5    ; str r0, [r1]    # HEAD->NEXT = ROOT
    0100A0E1    ; mov r0, r1    # ROOT = HEAD
    0210A0E1    ; mov r1, r2    # HEAD = NEXT
    F8FFFFEA    ; b Reverse_List_Loop    # Keep Going

:Reverse_List_Done ; .text offset 0x318, vaddr 0x1036c
    04209DE4    ; pop {r2}    # Restore R2
    04109DE4    ; pop {r1}    # Restore R1
    1EFF2FE1    ; bx r14
    ## Identify_Macros function
    ## Receives List in R0
    ## Updates the list in place; does not modify registers
    ## Uses R1 for DEFINE, R2 for I

:Identify_Macros ; .text offset 0x324, vaddr 0x10378
    04002DE5    ; push {r0}    # Protect R0
    04102DE5    ; push {r1}    # Protect R1
    04202DE5    ; push {r2}    # Protect R2
    04302DE5    ; push {r3}    # Protect R3
    6C108FE2    ; adr r1, DEFINE_str    # Setup define string
    0020A0E1    ; mov r2, r0    # I = HEAD

:Identify_Macros_Loop ; .text offset 0x33c, vaddr 0x10390
    100092E5    ; ldr r0, [r2, #16]    # I->TEXT
    04E02DE5    ; push {r14}
    190000EB    ; bl match    # IF "DEFINE" == I->TEXT
    04E09DE4    ; pop {r14}
    000050E3    ; cmp r0, #0    # Check if match
    0C00001A    ; bne Identify_Macros_Next    # Skip the work
    ## Deal with MACRO
    0100A0E3    ; mov r0, #1    # Using MACRO
    080082E5    ; str r0, [r2, #8]    # I->TYPE = MACRO
    000092E5    ; ldr r0, [r2]    # I->NEXT
    100090E5    ; ldr r0, [r0, #16]    # I->NEXT->TEXT
    100082E5    ; str r0, [r2, #16]    # I->TEXT = I->NEXT->TEXT
    000092E5    ; ldr r0, [r2]    # I->NEXT
    000090E5    ; ldr r0, [r0]    # I->NEXT->NEXT
    100090E5    ; ldr r0, [r0, #16]    # I->NEXT->NEXT->TEXT
    180082E5    ; str r0, [r2, #24]    # I->EXPRESSION = I->NEXT->NEXT->TEXT
    000092E5    ; ldr r0, [r2]    # I->NEXT
    000090E5    ; ldr r0, [r0]    # I->NEXT->NEXT
    000090E5    ; ldr r0, [r0]    # I->NEXT->NEXT->NEXT
    000082E5    ; str r0, [r2]    # I->NEXT = I->NEXT->NEXT->NEXT

:Identify_Macros_Next ; .text offset 0x388, vaddr 0x103dc
    002092E5    ; ldr r2, [r2]    # I = I->NEXT
    000052E3    ; cmp r2, #0    # Check for NULL
    E9FFFF1A    ; bne Identify_Macros_Loop    # Keep looping otherwise
    04309DE4    ; pop {r3}    # Restore R3
    04209DE4    ; pop {r2}    # Restore R2
    04109DE4    ; pop {r1}    # Restore R1
    04009DE4    ; pop {r0}    # Restore R0
    1EFF2FE1    ; bx r14

:DEFINE_str ; .text offset 0x3a8, vaddr 0x103fc
    44 45 46 49 4E 45 00 00    ; .byte 68, 69, 70, 73, 78, 69, 0, 0
    ## match function
    ## Receives CHAR* in R0 and CHAR* in R1
    ## Returns 0 (TRUE) or 1 (FALSE) in R0

:match ; .text offset 0x3b0, vaddr 0x10404
    04102DE5    ; push {r1}    # Protect R1
    04202DE5    ; push {r2}    # Protect R2
    04302DE5    ; push {r3}    # Protect R3
    0020A0E1    ; mov r2, r0    # S1 in place
    0130A0E1    ; mov r3, r1    # S2 in place

:match_Loop ; .text offset 0x3c4, vaddr 0x10418
    0000D2E5    ; ldrb r0, [r2]    # S1[0]
    0010D3E5    ; ldrb r1, [r3]    # S2[0]
    010050E1    ; cmp r0, r1    # See if they match
    0400001A    ; bne match_False    # If not
    012082E2    ; add r2, #1    # S1 = S1 + 1
    013083E2    ; add r3, #1    # S2 = S2 + 1
    000050E3    ; cmp r0, #0    # If reached end of string
    0100000A    ; beq match_Done    # Perfect match
    F6FFFFEA    ; b match_Loop    # Otherwise keep looping

:match_False ; .text offset 0x3e8, vaddr 0x1043c
    0100A0E3    ; mov r0, #1    # Return false

:match_Done ; .text offset 0x3ec, vaddr 0x10440
    04309DE4    ; pop {r3}    # Restore R3
    04209DE4    ; pop {r2}    # Restore R2
    04109DE4    ; pop {r1}    # Restore R1
    1EFF2FE1    ; bx r14
    ## Line_Macro function
    ## Receives List in R0
    ## Updates the list in place; does not modify registers
    ## Uses R0 for I, R1 for I->TEXT, R2 for I->EXPRESSION

:Line_Macro ; .text offset 0x3fc, vaddr 0x10450
    04002DE5    ; push {r0}    # Protect R0
    04102DE5    ; push {r1}    # Protect R1
    04202DE5    ; push {r2}    # Protect R2
    04302DE5    ; push {r3}    # Protect R3

:Line_Macro_Loop ; .text offset 0x40c, vaddr 0x10460
    081090E5    ; ldr r1, [r0, #8]    # I->TYPE
    010051E3    ; cmp r1, #1    # IF MACRO == I->TYPE
    0600001A    ; bne Line_Macro_Next    # Otherwise move on
    ## Is a macro apply
    101090E5    ; ldr r1, [r0, #16]    # I->TEXT
    182090E5    ; ldr r2, [r0, #24]    # I->EXPRESSION
    000090E5    ; ldr r0, [r0]    # I->NEXT
    04E02DE5    ; push {r14}
    090000EB    ; bl Set_Expression    # Apply it
    04E09DE4    ; pop {r14}
    F5FFFFEA    ; b Line_Macro_Loop    # Move on to next

:Line_Macro_Next ; .text offset 0x434, vaddr 0x10488
    000090E5    ; ldr r0, [r0]    # I->NEXT
    000050E3    ; cmp r0, #0    # Check for NULL
    F2FFFF1A    ; bne Line_Macro_Loop    # Keep going
    04309DE4    ; pop {r3}    # Restore R3
    04209DE4    ; pop {r2}    # Restore R2
    04109DE4    ; pop {r1}    # Restore R1
    04009DE4    ; pop {r0}    # Restore R0
    1EFF2FE1    ; bx r14
    ## Set_Expression function
    ## Receives List in R0, CHAR* in R1 and CHAR* in R2
    ## Updates the list in place; does not modify registers
    ## Uses R1 for C, R2 for EXP and R3 for I

:Set_Expression ; .text offset 0x454, vaddr 0x104a8
    04002DE5    ; push {r0}    # Protect R0
    04102DE5    ; push {r1}    # Protect R1
    04202DE5    ; push {r2}    # Protect R2
    04302DE5    ; push {r3}    # Protect R3
    0030A0E1    ; mov r3, r0    # Set I

:Set_Expression_Loop ; .text offset 0x468, vaddr 0x104bc
    080093E5    ; ldr r0, [r3, #8]    # I->TYPE
    010050E3    ; cmp r0, #1    # IF MACRO == I->TYPE
    0600000A    ; beq Set_Expression_Next    # Ignore and move on
    100093E5    ; ldr r0, [r3, #16]    # I->TEXT
    04E02DE5    ; push {r14}
    CBFFFFEB    ; bl match    # Check for match
    04E09DE4    ; pop {r14}
    000050E3    ; cmp r0, #0    # If match
    0000001A    ; bne Set_Expression_Next    # Otherwise next
    ## We have a non-macro match
    182083E5    ; str r2, [r3, #24]    # I->EXPRESSION = EXP

:Set_Expression_Next ; .text offset 0x490, vaddr 0x104e4
    003093E5    ; ldr r3, [r3]    # I = I->NEXT
    000053E3    ; cmp r3, #0    # IF NULL == I
    F2FFFF1A    ; bne Set_Expression_Loop    # Otherwise keep looping
    04309DE4    ; pop {r3}    # Restore R3
    04209DE4    ; pop {r2}    # Restore R2
    04109DE4    ; pop {r1}    # Restore R1
