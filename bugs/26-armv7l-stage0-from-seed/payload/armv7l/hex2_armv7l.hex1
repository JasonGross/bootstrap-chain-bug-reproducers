## hex2_armv7l: hand-assembled A32 rendering of the armv7l hex2-0 linker.
## Base = the x86-flavoured stage0-posix-armv7l GAS/hex2_x86.S reference,
## EXTENDED with the armv7l-specific pointer semantics that reference omits
## (a mechanical port left it x86-generic — PLAN §7.12). The extension is
## transcribed from and byte-verified against the C hex2 linker
## (mescc-tools 5adfbf33, hex2_linker.c), the tool the armv7l ecosystem
## actually uses. Two functional deltas from the GAS reference:
##   (1) base address 0x10000, not x86's 0x8048000 (PLAN §7.8);
##   (2) full armv7l pointer semantics (PLAN §7.12):
## hex2-0 links hex2: hex0's language plus multi-character ':label'
## definitions and the pointer forms
##   !label 1-byte rel   @label 2-byte rel   $label 2-byte abs
##   ~label 3-byte rel   %label 4-byte rel   &label 4-byte abs
## 'ptr>label2' rebases a relative against label2 (universal: target-label2).
## A leading '^' marks an ALIGNED (branch) pointer: the value becomes an
## instruction count ((target-base+(base&3))>>2)-2, so '^~foo EB' is an ARM
## 'bl foo'. Plain relatives carry the ARM PC-pipeline bias -8+(base&3).
## '<' pads the output up to the next 4-byte boundary. Two passes via lseek;
## labels live in a linked list on the brk heap (8 MB grabbed up front).
## Usage: ./hex2-0 <input.hex2> <output-binary>

## ELF Header

#:ELF_base ; vaddr 0x10000
7F 45 4C 46        ## e_ident[EI_MAG0-3] ELF's magic number

01                 ## e_ident[EI_CLASS] Indicating 32 bit
01                 ## e_ident[EI_DATA] Indicating little endianness
01                 ## e_ident[EI_VERSION] Indicating original elf

03                 ## e_ident[EI_OSABI] Set at 3 because FreeBSD is strict
00                 ## e_ident[EI_ABIVERSION] See above

00 00 00 00 00 00 00 ## e_ident[EI_PAD]

02 00              ## e_type Indicating Executable
28 00              ## e_machine Indicating 32bit ARM
01 00 00 00        ## e_version Indicating original elf

54 00 01 00        ## e_entry Address of the entry point (Number of bytes this header is + Base Address)
34 00 00 00        ## e_phoff Address of program header table
00 00 00 00        ## e_shoff Address of section header table

00 02 00 05        ## e_flags (EABI version 5, soft-float)

34 00              ## e_ehsize Indicating our 52 Byte header

20 00              ## e_phentsize size of a program header table
01 00              ## e_phnum number of entries in program table

00 00              ## e_shentsize size of a section header table
00 00              ## e_shnum number of entries in section table

00 00              ## e_shstrndx index of the section names

## Program Header

#:ELF_program_headers ; offset 0x34
01 00 00 00        ## p_type PT-LOAD = 1
00 00 00 00        ## p_offset

00 00 01 00        ## p_vaddr
00 00 01 00        ## p_physaddr

48 08 00 00        ## p_filesz
48 08 00 00        ## p_memsz (scratch buffer lives in the page's zero-filled slack; labels on the brk heap)

07 00 00 00        ## p_flags PF-X|PF-W|PF-R = 7
00 00 01 00        ## p_alignment

#:ELF_text ; offset 0x54, vaddr 0x10054

## Where the ELF Header is going to hit
## Simply jump to _start
## Our main function
    ## Register usage:
    ## R0, R3, R2, R1 => Temps
    ## R12 => IP
    ## R11 => MALLOC
    ## R10 => HEAD
    ## Struct format: (size 24)
    ## NEXT => 0
    ## TARGET => 8
    ## NAME => 16
    ## Where the ELF Header is going to hit
    ## Simply jump to _start
    ## Our main function

#:_start ; .text offset 0x0, vaddr 0x10054
    0000A0E3    ; mov r0, #0    # Get current pointer
    04E02DE5    ; push {r14}
    F00000EB    ; bl malloc    # Get current HEAP
    00B0A0E1    ; mov r11, r0    # Setup MALLOC
    7D0880E2    ; add r0, #8192000    # Create space for temp
    ED0000EB    ; bl malloc    # Give ourselves 8192000 bytes to work with
    04E09DE4    ; pop {r14}
    04009DE4    ; pop {r0}    # Get the number of arguments
    04009DE4    ; pop {r0}    # Get the program name
    04009DE4    ; pop {r0}    # Get the actual input name
    0010A0E3    ; mov r1, #0    # prepare read_only
    0020A0E3    ; mov r2, #0    # Really sure
    0570A0E3    ; mov r7, #5    # the syscall number for open()
    000000EF    ; svc #0    # Now open that damn file
    80879FE5    ; ldr r8, Input_address
    000088E5    ; str r0, [r8]    # Preserve the file pointer we were given
    04009DE4    ; pop {r0}    # Get the actual output name
    411200E3    ; mov r1, #577    # Prepare file as O_WRONLY|O_CREAT|O_TRUNC
    072DA0E3    ; mov r2, #448    # Prepare file as RWX for owner only (700 in octal)
    0570A0E3    ; mov r7, #5    # the syscall number for open()
    000000EF    ; svc #0    # Now open that damn file
    000050E3    ; cmp r0, #0    # Check for missing output
    000000CA    ; bgt _start_out    # Have real input
    0100A0E3    ; mov r0, #1    # Use stdout

#:_start_out ; .text offset 0x60, vaddr 0x100b4
    5C879FE5    ; ldr r8, Output_address
    000088E5    ; str r0, [r8]    # Preserve the file pointer we were given
    04E02DE5    ; push {r14}
    3A0100EB    ; bl ClearScratch    # Zero scratch
    04E09DE4    ; pop {r14}
    0000E0E3    ; mov r0, #-1    # Our flag for byte processing
    3C879FE5    ; ldr r8, Flag_address
    000088E5    ; str r0, [r8]    # Set
    0000A0E3    ; mov r0, #0    # temp storage for the sum
    2C879FE5    ; ldr r8, High_address
    000088E5    ; str r0, [r8]    # Set
    40C79FE5    ; ldr r12, start_address    # Our starting IP
    00A0A0E3    ; mov r10, #0    # HEAD = NULL
    04E02DE5    ; push {r14}
    130000EB    ; bl First_pass    # Process it
    04E09DE4    ; pop {r14}
    ## rewind input file
    18879FE5    ; ldr r8, Input_address
    000098E5    ; ldr r0, [r8]    # Using our input file
    0010A0E3    ; mov r1, #0    # Offset Zero
    0020A0E3    ; mov r2, #0    # Whence Zero
    1370A0E3    ; mov r7, #19    # lseek
    04A02DE5    ; push {r10}    # Protect HEAD
    000000EF    ; svc #0
    04A09DE4    ; pop {r10}    # Restore HEAD
    0000E0E3    ; mov r0, #-1    # Our flag for byte processing
    F0869FE5    ; ldr r8, Flag_address
    000088E5    ; str r0, [r8]    # Set
    0000A0E3    ; mov r0, #0    # temp storage for the sum
    E0869FE5    ; ldr r8, High_address
    000088E5    ; str r0, [r8]    # Set
    F4C69FE5    ; ldr r12, start_address    # Our starting IP
    04E02DE5    ; push {r14}
    660000EB    ; bl Second_pass    # Process it
    04E09DE4    ; pop {r14}
    B50000EA    ; b Done

#:First_pass ; .text offset 0xec, vaddr 0x10140
    04E02DE5    ; push {r14}
    BD0000EB    ; bl Read_byte
    04E09DE4    ; pop {r14}
    ## Deal with EOF
    040070E3    ; cmp r0, #-4
    4B00000A    ; beq First_pass_done
    ## Check for :
    3A0050E3    ; cmp r0, #0x3a
    0000001A    ; bne First_pass_0
    ## Deal with label
    EC0000EA    ; b StoreLabel

#:First_pass_0 ; .text offset 0x10c, vaddr 0x10160
    ## Check for !
    210050E3    ; cmp r0, #0x21
    3800000A    ; beq First_pass_pointer
    ## Check for @
    400050E3    ; cmp r0, #0x40
    3600000A    ; beq First_pass_pointer
    ## Check for $
    240050E3    ; cmp r0, #0x24
    3400000A    ; beq First_pass_pointer
    ## Check for %
    250050E3    ; cmp r0, #0x25
    3200000A    ; beq First_pass_pointer
    ## Check for &
    260050E3    ; cmp r0, #0x26
    3000000A    ; beq First_pass_pointer
    ## Check for ~ (armv7l 3-byte relative)
    7E0050E3    ; cmp r0, #0x7E
    2E00000A    ; beq First_pass_pointer
    ## Check for < (align IP to 4 bytes)
    3C0050E3    ; cmp r0, #0x3C
    2300000A    ; beq First_pass_align
    ## Check for ^ (aligned-branch flag; no effect in the IP-counting pass)
    5E0050E3    ; cmp r0, #0x5E
    E7FFFF0A    ; beq First_pass
    ## Deal with everything else
    04E02DE5    ; push {r14}
    370000EB    ; bl hex    # Process our char
    04E09DE4    ; pop {r14}
    ## Deal with EOF
    040070E3    ; cmp r0, #-4
    3300000A    ; beq First_pass_done
    ## deal with -1 values
    000050E3    ; cmp r0, #0
    E0FFFFBA    ; blt First_pass
    ## deal with toggle
    4C869FE5    ; ldr r8, Flag_address
    000098E5    ; ldr r0, [r8]
    000050E3    ; cmp r0, #0
    0000000A    ; beq First_pass_1
    01C08CE2    ; add r12, #1    # Increment IP

#:First_pass_1 ; .text offset 0x17c, vaddr 0x101d0
    0000E0E1    ; mvn r0, r0
    34869FE5    ; ldr r8, Flag_address
    000088E5    ; str r0, [r8]    # Set Flag
    D7FFFFEA    ; b First_pass

#:Update_Pointer ; .text offset 0x18c, vaddr 0x101e0
    ## Check for !
    210050E3    ; cmp r0, #0x21
    0D00000A    ; beq Update_Pointer_1
    ## Check for @
    400050E3    ; cmp r0, #0x40
    0A00000A    ; beq Update_Pointer_2
    ## Check for $
    240050E3    ; cmp r0, #0x24
    0800000A    ; beq Update_Pointer_2
    ## Check for %
    250050E3    ; cmp r0, #0x25
    0400000A    ; beq Update_Pointer_4
    ## Check for &
    260050E3    ; cmp r0, #0x26
    0200000A    ; beq Update_Pointer_4
    ## Check for ~ (armv7l 3-byte relative)
    7E0050E3    ; cmp r0, #0x7E
    0100000A    ; beq Update_Pointer_3
    ## deal with bad input
    7A0100EA    ; b fail

#:Update_Pointer_4 ; .text offset 0x1c0, vaddr 0x10214
    01C08CE2    ; add r12, #1    # Increment IP

#:Update_Pointer_3 ; .text offset 0x1c4, vaddr 0x10218
    01C08CE2    ; add r12, #1    # Increment IP

#:Update_Pointer_2 ; .text offset 0x1c8, vaddr 0x1021c
    01C08CE2    ; add r12, #1    # Increment IP

#:Update_Pointer_1 ; .text offset 0x1cc, vaddr 0x10220
    01C08CE2    ; add r12, #1    # Increment IP
    1EFF2FE1    ; bx r14
    ## Align IP up to the next 4-byte boundary (first pass: count only).
    ## Mirrors the C hex2 pad_to_align's sequential (ip&1) then (ip&2) test.

#:First_pass_align ; .text offset 0x1d4, vaddr 0x10228
    01000CE2    ; and r0, r12, #1
    010050E3    ; cmp r0, #1
    0000001A    ; bne First_pass_align_2
    01C08CE2    ; add r12, #1    # Increment IP

#:First_pass_align_2 ; .text offset 0x1e4, vaddr 0x10238
    02000CE2    ; and r0, r12, #2
    020050E3    ; cmp r0, #2
    BEFFFF1A    ; bne First_pass
    02C08CE2    ; add r12, #2    # Increment IP
    BCFFFFEA    ; b First_pass

#:First_pass_pointer ; .text offset 0x1f8, vaddr 0x1024c
    ## Deal with Pointer to label
    04E02DE5    ; push {r14}
    E2FFFFEB    ; bl Update_Pointer    # Increment IP
    C4159FE5    ; ldr r1, table_address    # Using scratch
    9B0000EB    ; bl consume_token    # Read token
    D30000EB    ; bl ClearScratch    # Throw away token
    04E09DE4    ; pop {r14}
    3E0050E3    ; cmp r0, #0x3E    # check for '>'
    B4FFFF1A    ; bne First_pass    # Loop again
    ## Deal with %label>label case
    AC159FE5    ; ldr r1, table_address    # Write to scratch
    04E02DE5    ; push {r14}
    940000EB    ; bl consume_token    # get token
    CC0000EB    ; bl ClearScratch    # Clean up after ourselves
    04E09DE4    ; pop {r14}
    AEFFFFEA    ; b First_pass    # Loop again

#:First_pass_done ; .text offset 0x230, vaddr 0x10284
    1EFF2FE1    ; bx r14

#:hex ; .text offset 0x234, vaddr 0x10288
    ## deal with EOF
    040070E3    ; cmp r0, #-4
    4000000A    ; beq EOF
    ## deal with line comments starting with #
    230050E3    ; cmp r0, #0x23
    4700000A    ; beq ascii_comment
    ## deal with line comments starting with ;
    3B0050E3    ; cmp r0, #0x3b
    4500000A    ; beq ascii_comment
    ## deal all ascii less than 0
    300050E3    ; cmp r0, #0x30
    410000BA    ; blt ascii_other
    ## deal with 0-9
    3A0050E3    ; cmp r0, #0x3a
    390000BA    ; blt ascii_num
    ## deal with all ascii less than A
    410050E3    ; cmp r0, #0x41
    3D0000BA    ; blt ascii_other
    ## deal with A-F
    470050E3    ; cmp r0, #0x47
    390000BA    ; blt ascii_high
    ## deal with all ascii less than a
    610050E3    ; cmp r0, #0x61
    390000BA    ; blt ascii_other
    ## deal with a-f
    670050E3    ; cmp r0, #0x67
    330000BA    ; blt ascii_low
    ## The rest that remains needs to be ignored
    360000EA    ; b ascii_other

#:Second_pass ; .text offset 0x280, vaddr 0x102d4
    04E02DE5    ; push {r14}
    580000EB    ; bl Read_byte
    04E09DE4    ; pop {r14}
    ## Deal with EOF
    040070E3    ; cmp r0, #-4
    2900000A    ; beq Second_pass_done
    ## Simply drop the label
    3A0050E3    ; cmp r0, #0x3a
    0500001A    ; bne Second_pass_0
    28159FE5    ; ldr r1, table_address    # Using scratch
    04E02DE5    ; push {r14}
    730000EB    ; bl consume_token    # Read token
    AB0000EB    ; bl ClearScratch    # Throw away token
    04E09DE4    ; pop {r14}
    F2FFFFEA    ; b Second_pass

#:Second_pass_0 ; .text offset 0x2b4, vaddr 0x10308
    ## Deal with % pointer
    250050E3    ; cmp r0, #0x25
    0101000A    ; beq StorePointer_rel4
    ## Deal with @ pointer
    400050E3    ; cmp r0, #0x40
    1301000A    ; beq StorePointer_rel2
    ## Deal with ! pointer
    210050E3    ; cmp r0, #0x21
    1B01000A    ; beq StorePointer_rel1
    ## Deal with & pointer
    260050E3    ; cmp r0, #0x26
    2301000A    ; beq StorePointer_abs4
    ## Deal with $ pointer
    240050E3    ; cmp r0, #0x24
    2A01000A    ; beq StorePointer_abs2
    ## Deal with ~ pointer (armv7l 3-byte relative)
    7E0050E3    ; cmp r0, #0x7E
    0101000A    ; beq StorePointer_rel3
    ## Deal with < (align output to 4 bytes)
    3C0050E3    ; cmp r0, #0x3C
    AD00000A    ; beq Second_pass_align
    ## Deal with ^ (set the aligned-branch flag for the next pointer)
    5E0050E3    ; cmp r0, #0x5E
    A700000A    ; beq Second_pass_aligned

#:Second_pass_1 ; .text offset 0x2f4, vaddr 0x10348
    ## Deal with everything else
    04E02DE5    ; push {r14}
    CDFFFFEB    ; bl hex    # Process our char
    04E09DE4    ; pop {r14}
    ## Deal with EOF
    040070E3    ; cmp r0, #-4
    0C00000A    ; beq Second_pass_done
    ## deal with -1 values
    000050E3    ; cmp r0, #0
    DBFFFFBA    ; blt Second_pass
    ## deal with toggle
    A4849FE5    ; ldr r8, Flag_address
    001098E5    ; ldr r1, [r8]
    000051E3    ; cmp r1, #0
    1900000A    ; beq print
    ## process first byte of pair
    0002A0E1    ; lsl r0, #4
    8C849FE5    ; ldr r8, High_address
    000088E5    ; str r0, [r8]
    0000A0E3    ; mov r0, #0
    84849FE5    ; ldr r8, Flag_address
    000088E5    ; str r0, [r8]
    D0FFFFEA    ; b Second_pass

#:Second_pass_done ; .text offset 0x33c, vaddr 0x10390
    1EFF2FE1    ; bx r14

#:EOF ; .text offset 0x340, vaddr 0x10394
    1EFF2FE1    ; bx r14

#:ascii_num ; .text offset 0x344, vaddr 0x10398
    300040E2    ; sub r0, #0x30
    1EFF2FE1    ; bx r14

#:ascii_low ; .text offset 0x34c, vaddr 0x103a0
    570040E2    ; sub r0, #0x57
    1EFF2FE1    ; bx r14

#:ascii_high ; .text offset 0x354, vaddr 0x103a8
    370040E2    ; sub r0, #0x37
    1EFF2FE1    ; bx r14

#:ascii_other ; .text offset 0x35c, vaddr 0x103b0
    0000E0E3    ; mov r0, #-1
    1EFF2FE1    ; bx r14

#:ascii_comment ; .text offset 0x364, vaddr 0x103b8
    04E02DE5    ; push {r14}
    1F0000EB    ; bl Read_byte
    04E09DE4    ; pop {r14}
    0D0050E3    ; cmp r0, #0xd
    0100000A    ; beq ascii_comment_cr
    0A0050E3    ; cmp r0, #0xa
    F8FFFF1A    ; bne ascii_comment

#:ascii_comment_cr ; .text offset 0x380, vaddr 0x103d4
    0000E0E3    ; mov r0, #-1
    1EFF2FE1    ; bx r14
    ## process second byte of pair

#:print ; .text offset 0x388, vaddr 0x103dc
    ## update the sum and store in output
    28849FE5    ; ldr r8, High_address
    008098E5    ; ldr r8, [r8]
    080080E0    ; add r0, r8
    30849FE5    ; ldr r8, table_address
    0000C8E5    ; strb r0, [r8]
    ## flip the toggle
    18849FE5    ; ldr r8, Flag_address
    000098E5    ; ldr r0, [r8]
    0000E0E1    ; mvn r0, r0
    000088E5    ; str r0, [r8]
    ## Print our first Hex
    0120A0E3    ; mov r2, #1    # set the size of chars we want
    04E02DE5    ; push {r14}
    210000EB    ; bl print_chars
    04E09DE4    ; pop {r14}
    01C08CE2    ; add r12, #1    # Increment IP
    AEFFFFEA    ; b Second_pass

#:Done ; .text offset 0x3c4, vaddr 0x10418
    ## program completed Successfully
    0000A0E3    ; mov r0, #0    # All is well
    0170A0E3    ; mov r7, #1    # put the exit syscall number in r0
    000000EF    ; svc #0    # Call it a good day
    ## Malloc isn't actually required if the program being built fits in the initial memory
    ## However, it doesn't take much to add it.
    ## Requires a value in R1

#:malloc ; .text offset 0x3d0, vaddr 0x10424
    2D70A0E3    ; mov r7, #45    # the Syscall # for SYS_BRK
    04A02DE5    ; push {r10}    # Protect r10
    04C02DE5    ; push {r12}    # Protect r12
    000000EF    ; svc #0    # call the Kernel
    04C09DE4    ; pop {r12}    # Restore r12
    04A09DE4    ; pop {r10}    # Restore r10
    1EFF2FE1    ; bx r14

#:Read_byte ; .text offset 0x3ec, vaddr 0x10440
    ## Attempt to read 1 byte from STDIN
    04A02DE5    ; push {r10}    # Protect r10
    04C02DE5    ; push {r12}    # Protect r12
    04102DE5    ; push {r1}    # Protect r1
    04202DE5    ; push {r2}    # Protect r2
    0120A0E3    ; mov r2, #1    # set the size of chars we want
    C0139FE5    ; ldr r1, write_address    # Where to put it
    B4839FE5    ; ldr r8, Input_address
    000098E5    ; ldr r0, [r8]    # Where are we reading from
    0370A0E3    ; mov r7, #3    # the syscall number for read
    000000EF    ; svc #0    # call the Kernel
    04209DE4    ; pop {r2}    # Restore r2
    04109DE4    ; pop {r1}    # Restore r1
    04C09DE4    ; pop {r12}    # Restore r12
    04A09DE4    ; pop {r10}    # Restore r10
    000050E3    ; cmp r0, #0    # check what we got
    0200000A    ; beq Read_byte_1    # Got EOF call it done
    ## load byte
    94839FE5    ; ldr r8, write_address
    0000D8E5    ; ldrb r0, [r8]    # load char
    1EFF2FE1    ; bx r14
    ## Deal with EOF

#:Read_byte_1 ; .text offset 0x438, vaddr 0x1048c
    0300E0E3    ; mov r0, #-4    # Put EOF in r0
    1EFF2FE1    ; bx r14

#:print_chars ; .text offset 0x440, vaddr 0x10494
    04A02DE5    ; push {r10}    # Protect r10
    04C02DE5    ; push {r12}    # Protect r12
    04002DE5    ; push {r0}    # Protect r0
    04102DE5    ; push {r1}    # Protect r1
    74139FE5    ; ldr r1, table_address    # What we are writing
    68839FE5    ; ldr r8, Output_address
    000098E5    ; ldr r0, [r8]    # Write to target file
    0470A0E3    ; mov r7, #4    # the syscall number for write
    000000EF    ; svc #0    # call the Kernel
    04109DE4    ; pop {r1}    # Restore r1
    04009DE4    ; pop {r0}    # Restore r0
    04C09DE4    ; pop {r12}    # Restore r12
    04A09DE4    ; pop {r10}    # Restore r10
    1EFF2FE1    ; bx r14
    ## Receives pointer in R1
    ## Writes out char and updates R1

#:consume_token ; .text offset 0x478, vaddr 0x104cc
    04E02DE5    ; push {r14}
    DAFFFFEB    ; bl Read_byte    # Consume_token
    04E09DE4    ; pop {r14}
    ## Check for \t
    090050E3    ; cmp r0, #0x09
    0800000A    ; beq consume_token_done
    ## Check for \n
    0A0050E3    ; cmp r0, #0x0A
    0600000A    ; beq consume_token_done
    ## Check for ' '
    200050E3    ; cmp r0, #0x20
    0400000A    ; beq consume_token_done
    ## Check for '>'
    3E0050E3    ; cmp r0, #0x3E
    0200000A    ; beq consume_token_done
    ## Looks like we are still reading token
    0000C1E5    ; strb r0, [r1]    # Store char
    011081E2    ; add r1, #1    # Point to next spot
    F1FFFFEA    ; b consume_token    # loop until done

#:consume_token_done ; .text offset 0x4b0, vaddr 0x10504
    0020A0E3    ; mov r2, #0    # Pad with nulls
    002081E5    ; str r2, [r1]
    041081E2    ; add r1, #4
    1EFF2FE1    ; bx r14

#:StoreLabel ; .text offset 0x4c0, vaddr 0x10514
    0B00A0E1    ; mov r0, r11    # ENTRY
    18B08BE2    ; add r11, #24    # CALLOC
    08C080E5    ; str r12, [r0, #8]    # ENTRY->TARGET = IP
    00A080E5    ; str r10, [r0]    # ENTRY->NEXT = JUMP_TABLE
    00A0A0E1    ; mov r10, r0    # JUMP_TABLE = ENTRY
    10B08AE5    ; str r11, [r10, #16]    # ENTRY->NAME = TOKEN
    0B10A0E1    ; mov r1, r11    # Write Starting after struct
    04E02DE5    ; push {r14}
    E4FFFFEB    ; bl consume_token    # Collect whole string
    04E09DE4    ; pop {r14}
    01B0A0E1    ; mov r11, r1    # Update HEAP
    FEFEFFEA    ; b First_pass

#:GetTarget ; .text offset 0x4f0, vaddr 0x10544
    04102DE5    ; push {r1}    # protect r1
    04202DE5    ; push {r2}    # protect r2
    04302DE5    ; push {r3}    # protect r3
    04A02DE5    ; push {r10}    # protect JUMP_TABLE
    C4229FE5    ; ldr r2, table_address    # Reset scratch
    10309AE5    ; ldr r3, [r10, #16]    # I->NAME

#:GetTarget_loop ; .text offset 0x508, vaddr 0x1055c
    0000D2E5    ; ldrb r0, [r2]    # I->NAME[0]
    0010D3E5    ; ldrb r1, [r3]    # scratch[0]
    010050E1    ; cmp r0, r1    # IF TOKEN == I->NAME
    0400001A    ; bne GetTarget_miss    # Oops
    012082E2    ; add r2, #1
    013083E2    ; add r3, #1
    000050E3    ; cmp r0, #0
    F7FFFF1A    ; bne GetTarget_loop    # Loop until
    050000EA    ; b GetTarget_done    # Match
    ## Miss

#:GetTarget_miss ; .text offset 0x52c, vaddr 0x10580
    00A09AE5    ; ldr r10, [r10]    # I = I->NEXT
    00005AE3    ; cmp r10, #0    # IF NULL == I
    9C00000A    ; beq fail    # Abort hard
    10309AE5    ; ldr r3, [r10, #16]    # I->NAME
    88229FE5    ; ldr r2, table_address    # Reset scratch
    F0FFFFEA    ; b GetTarget_loop

#:GetTarget_done ; .text offset 0x544, vaddr 0x10598
    08009AE5    ; ldr r0, [r10, #8]    # Get address
    04A09DE4    ; pop {r10}    # Restore JUMP_TABLE
    04309DE4    ; pop {r3}    # Restore R3
    04209DE4    ; pop {r2}    # Restore R2
    04109DE4    ; pop {r1}    # Restore R1
    1EFF2FE1    ; bx r14

#:ClearScratch ; .text offset 0x55c, vaddr 0x105b0
    04002DE5    ; push {r0}    # Protect against changes
    04102DE5    ; push {r1}    # And overwrites
    04202DE5    ; push {r2}    # While we work
    5C129FE5    ; ldr r1, table_address    # Where our table is
    0000A0E3    ; mov r0, #0    # Using null

#:ClearScratch_loop ; .text offset 0x570, vaddr 0x105c4
    0020D1E5    ; ldrb r2, [r1]    # Get current value
    0000C1E5    ; strb r0, [r1]    # Because we want null
    011081E2    ; add r1, #1    # Increment
    000052E3    ; cmp r2, #0    # Check if we hit null
    FAFFFF1A    ; bne ClearScratch_loop    # Keep looping
    04209DE4    ; pop {r2}    # Restore
    04109DE4    ; pop {r1}    # Damage
    04009DE4    ; pop {r0}    # Entirely
    1EFF2FE1    ; bx r14
    ## Set the aligned-branch flag for the next pointer (the '^' sigil).

#:Second_pass_aligned ; .text offset 0x594, vaddr 0x105e8
    0100A0E3    ; mov r0, #1
    30829FE5    ; ldr r8, Aligned_address
    000088E5    ; str r0, [r8]    # ALIGNED = TRUE
    36FFFFEA    ; b Second_pass
    ## Align output up to the next 4-byte boundary, emitting zero bytes (the '<'
    ## sigil). Mirrors the C hex2 pad_to_align: sequential (ip&1) then (ip&2).

#:Second_pass_align ; .text offset 0x5a4, vaddr 0x105f8
    01000CE2    ; and r0, r12, #1
    010050E3    ; cmp r0, #1
    0700001A    ; bne Second_pass_align_2
    01C08CE2    ; add r12, #1    # Increment IP
    0000A0E3    ; mov r0, #0    # one zero byte
    0C829FE5    ; ldr r8, table_address
    000088E5    ; str r0, [r8]    # scratch = 0
    0120A0E3    ; mov r2, #1
    04E02DE5    ; push {r14}
    9CFFFFEB    ; bl print_chars
    04E09DE4    ; pop {r14}

#:Second_pass_align_2 ; .text offset 0x5d0, vaddr 0x10624
    02000CE2    ; and r0, r12, #2
    020050E3    ; cmp r0, #2
    28FFFF1A    ; bne Second_pass
    02C08CE2    ; add r12, #2    # Increment IP
    0000A0E3    ; mov r0, #0    # two zero bytes
    E0819FE5    ; ldr r8, table_address
    000088E5    ; str r0, [r8]    # scratch = 0
    0220A0E3    ; mov r2, #2
    04E02DE5    ; push {r14}
    91FFFFEB    ; bl print_chars
    04E09DE4    ; pop {r14}
    1FFFFFEA    ; b Second_pass

#:StorePointer ; .text offset 0x600, vaddr 0x10654
    0060A0E3    ; mov r6, #0    # base_sep_p is not '>' unless proven so
    04E02DE5    ; push {r14}
    DFFEFFEB    ; bl Update_Pointer    # Increment IP
    B8119FE5    ; ldr r1, table_address    # Write to scratch
    98FFFFEB    ; bl consume_token    # get token
    04E09DE4    ; pop {r14}
    04002DE5    ; push {r0}    # Protect base_sep_p
    A8019FE5    ; ldr r0, table_address    # Pointer to scratch
    04E02DE5    ; push {r14}
    B1FFFFEB    ; bl GetTarget    # Get address of pointer
    CBFFFFEB    ; bl ClearScratch    # Clean up after ourselves
    04E09DE4    ; pop {r14}
    0C30A0E1    ; mov r3, r12    # base = IP
    04109DE4    ; pop {r1}    # Restore base_sep_p
    3E0051E3    ; cmp r1, #0x3E    # If base_sep_p == '>'
    0A00001A    ; bne StorePointer_done    # If not
    ## Deal with %label>label case
    0160A0E3    ; mov r6, #1    # Remember: displacement is universal (no arch bias)
    04002DE5    ; push {r0}    # We need to preserve main target
    7C119FE5    ; ldr r1, table_address    # Write to scratch
    04E02DE5    ; push {r14}
    88FFFFEB    ; bl consume_token    # get token
    70019FE5    ; ldr r0, table_address    # Pointer to scratch
    A4FFFFEB    ; bl GetTarget    # Get address of pointer
    BEFFFFEB    ; bl ClearScratch    # Clean up after ourselves
    04E09DE4    ; pop {r14}
    0030A0E1    ; mov r3, r0    # Use our new base
    04009DE4    ; pop {r0}    # Restore main target

#:StorePointer_done ; .text offset 0x66c, vaddr 0x106c0
    1EFF2FE1    ; bx r14
    ## Rel_Displacement: given target in r0, base in r3, rebased flag in r6,
    ## return the armv7l relative displacement in r0. Transcribes the C hex2
    ## linker's storePointer + Architectural_displacement (mescc-tools armv7l):
    ## rebased ('>' form): target - base  (universal, no arch bias, ALIGNED
    ## untouched)
    ## aligned ('^' form): ((target - base + (base & 3)) >> 2) - 2, ALIGNED := 0
    ## plain:              (target - base) - 8 + (base & 3)   (ARM PC-pipeline)

#:Rel_Displacement ; .text offset 0x670, vaddr 0x106c4
    000056E3    ; cmp r6, #0
    1000001A    ; bne Rel_Displacement_rebased
    50819FE5    ; ldr r8, Aligned_address
    001098E5    ; ldr r1, [r8]
    000051E3    ; cmp r1, #0
    0400001A    ; bne Rel_Displacement_aligned
    ## plain relative: (target - base) - 8 + (base & 3)
    030040E0    ; sub r0, r3    # target - base
    080040E2    ; sub r0, #8    # - 8 (PC prefetch is two instructions ahead)
    031003E2    ; and r1, r3, #3    # base & 3
    010080E0    ; add r0, r1
    1EFF2FE1    ; bx r14

#:Rel_Displacement_aligned ; .text offset 0x69c, vaddr 0x106f0
    ## ((target - base + (base & 3)) >> 2) - 2 ; then clear ALIGNED
    030040E0    ; sub r0, r3    # target - base
    031003E2    ; and r1, r3, #3    # base & 3
    010080E0    ; add r0, r1
    4001A0E1    ; asr r0, r0, #2    # >> 2 (branch offset is in instructions)
    020040E2    ; sub r0, #2
    0010A0E3    ; mov r1, #0
    001088E5    ; str r1, [r8]    # ALIGNED = FALSE
    1EFF2FE1    ; bx r14

#:Rel_Displacement_rebased ; .text offset 0x6bc, vaddr 0x10710
    030040E0    ; sub r0, r3    # target - base (base is the rebase label)
    1EFF2FE1    ; bx r14

#:StorePointer_rel4 ; .text offset 0x6c4, vaddr 0x10718
    04E02DE5    ; push {r14}
    CCFFFFEB    ; bl StorePointer    # Do Common
    E7FFFFEB    ; bl Rel_Displacement    # Apply armv7l relative bias
    F4809FE5    ; ldr r8, table_address
    000088E5    ; str r0, [r8]    # put value in output
    0420A0E3    ; mov r2, #4    # set the size of chars we want
    57FFFFEB    ; bl print_chars
    9DFFFFEB    ; bl ClearScratch    # Clean up after ourselves
    04E09DE4    ; pop {r14}
    E4FEFFEA    ; b Second_pass

#:StorePointer_rel3 ; .text offset 0x6ec, vaddr 0x10740
    04E02DE5    ; push {r14}
    C2FFFFEB    ; bl StorePointer    # Do Common
    DDFFFFEB    ; bl Rel_Displacement    # Apply armv7l relative bias
    CC809FE5    ; ldr r8, table_address
    000088E5    ; str r0, [r8]    # put value in output
    0320A0E3    ; mov r2, #3    # set the size of chars we want
    4DFFFFEB    ; bl print_chars
    93FFFFEB    ; bl ClearScratch    # Clean up after ourselves
    04E09DE4    ; pop {r14}
    DAFEFFEA    ; b Second_pass

#:StorePointer_rel2 ; .text offset 0x714, vaddr 0x10768
    04E02DE5    ; push {r14}
    B8FFFFEB    ; bl StorePointer    # Do Common
    D3FFFFEB    ; bl Rel_Displacement    # Apply armv7l relative bias
    A4809FE5    ; ldr r8, table_address
    000088E5    ; str r0, [r8]    # put value in output
    0220A0E3    ; mov r2, #2    # set the size of chars we want
    43FFFFEB    ; bl print_chars
    89FFFFEB    ; bl ClearScratch    # Clean up after ourselves
    04E09DE4    ; pop {r14}
    D0FEFFEA    ; b Second_pass

#:StorePointer_rel1 ; .text offset 0x73c, vaddr 0x10790
    04E02DE5    ; push {r14}
    AEFFFFEB    ; bl StorePointer    # Do Common
    C9FFFFEB    ; bl Rel_Displacement    # Apply armv7l relative bias
    7C809FE5    ; ldr r8, table_address
    000088E5    ; str r0, [r8]    # put value in output
    0120A0E3    ; mov r2, #1    # set the size of chars we want
    39FFFFEB    ; bl print_chars
    7FFFFFEB    ; bl ClearScratch    # Clean up after ourselves
    04E09DE4    ; pop {r14}
    C6FEFFEA    ; b Second_pass

#:StorePointer_abs4 ; .text offset 0x764, vaddr 0x107b8
    04E02DE5    ; push {r14}
    A4FFFFEB    ; bl StorePointer    # Do Common
    58809FE5    ; ldr r8, table_address
    000088E5    ; str r0, [r8]    # put value in output
    0420A0E3    ; mov r2, #4    # set the size of chars we want
    30FFFFEB    ; bl print_chars
    76FFFFEB    ; bl ClearScratch    # Clean up after ourselves
    04E09DE4    ; pop {r14}
    BDFEFFEA    ; b Second_pass

#:StorePointer_abs2 ; .text offset 0x788, vaddr 0x107dc
    04E02DE5    ; push {r14}
    9BFFFFEB    ; bl StorePointer    # Do Common
    34809FE5    ; ldr r8, table_address
    000088E5    ; str r0, [r8]    # put value in output
    0220A0E3    ; mov r2, #2    # set the size of chars we want
    27FFFFEB    ; bl print_chars
    6DFFFFEB    ; bl ClearScratch    # Clean up after ourselves
    04E09DE4    ; pop {r14}
    B4FEFFEA    ; b Second_pass

#:fail ; .text offset 0x7ac, vaddr 0x10800
    ## Some shit went wrong
    0100A0E3    ; mov r0, #1    # All is wrong
    0170A0E3    ; mov r7, #1    # put the exit syscall number in r0
    000000EF    ; svc #0    # Call it a good day
    ## Because ARM doesn't support loading/storing directly to different segments in a single instruction
    ## Because ARM does't support full size immediates

#:ELF_end ; .text offset 0x7b8, vaddr 0x1080c

#:High ; .text offset 0x7b8, vaddr 0x1080c

#:Flag ; .text offset 0x7b8, vaddr 0x1080c

#:Input ; .text offset 0x7b8, vaddr 0x1080c

#:Output ; .text offset 0x7b8, vaddr 0x1080c

#:write ; .text offset 0x7b8, vaddr 0x1080c

#:Aligned ; .text offset 0x7b8, vaddr 0x1080c

#:table ; .text offset 0x7b8, vaddr 0x1080c

## literal pool (data-cell addresses + the arch base; ARM cannot address
## across segments in one instruction) — .text offset 0x7b8, vaddr 0x1080c
#:High_address
    2C080100   ; .word High (0x1082c)
#:Flag_address
    30080100   ; .word Flag (0x10830)
#:Input_address
    34080100   ; .word Input (0x10834)
#:Output_address
    38080100   ; .word Output (0x10838)
#:write_address
    3C080100   ; .word write (0x1083c)
#:table_address
    44080100   ; .word table (0x10844)
#:Aligned_address
    40080100   ; .word Aligned (0x10840)
#:start_address
    00000100   ; .word base address 0x10000 (armv7l convention; upstream GAS carries the x86 0x8048000 — PLAN §7.8)

## data (file offset 0x82c, vaddr 0x1082c); the scratch/token buffer
## at 'table' grows past the file image into the page's zero-filled slack;
## 'Aligned' is the ^-flag cell (set by ^, cleared after each aligned pointer)
#:High
    00000000
#:Flag
    00000000
#:Input
    00000000
#:Output
    00000000
#:write
    00000000
#:Aligned
    00000000
#:table
    42000000  # .word 66 — faithful to the reference (first ClearScratch wipes it)
