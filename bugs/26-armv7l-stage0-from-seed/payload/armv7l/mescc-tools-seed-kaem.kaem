## armv7l seed phase (mirrors x86's mescc-tools-seed-kaem.kaem).
## Run by hand or by the hex0-seed's companion kaem seed; everything after
## this is driven by artifact/kaem-0.

#############################################
# Phase-0 Build hex0 from the hex0 seed     #
#############################################
./bootstrap-seeds/POSIX/armv7l/hex0-seed ./armv7l/hex0_armv7l.hex0 ./armv7l/artifact/hex0
# hex0 is byte-identical to the seed that built it (upstream convention,
# asserted by scripts/seed-gate.sh)

#############################################
# Phase-0b Build kaem-0 from hex0           #
#############################################
./armv7l/artifact/hex0 ./armv7l/kaem-minimal.hex0 ./armv7l/artifact/kaem-0
# kaem-0 == bootstrap-seeds/POSIX/armv7l/kaem-optional-seed (the ladder edge,
# asserted by scripts/kaem-gate.sh)
