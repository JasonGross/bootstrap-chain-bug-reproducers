## armv7l mini-kaem: seed -> bin/{M1,hex2,kaem}.  Transcribed from x86's
## mescc-tools-mini-kaem.kaem (the structural model) with the
## armv7l substitutions: arch dir, listing names, --architecture armv7l,
## M2libc/armv7l, ELF-armv7l{,-debug}.hex2, --base-address 0x00010000.
## Literal paths throughout — this file is run by kaem-0 (kaem-minimal),
## which has no variables; the variable-driven full-kaem takes over after.
##
## TWO defs LAYERS, as on x86:
##   phase 5 (cc_armv7l's own output)  -> ./armv7l/{armv7l_defs,libc-core}.M1
##   phase 6+ (M2-Planet's output)     -> ./M2libc/armv7l/{armv7l_defs,libc-core}.M1
## Same filenames, different directories, different content.
##
## Can also be run by kaem or any other shell of your personal choice.
## Warning: all binaries prior to blood-elf carry no debug info.

#################################
# Phase-1 Build hex1 from hex0  #
#################################
./armv7l/artifact/hex0 ./armv7l/hex1_armv7l.hex0 ./armv7l/artifact/hex1
# hex1 adds support for single character labels

#################################
# Phase-2 Build hex2 from hex1  #
#################################
./armv7l/artifact/hex1 ./armv7l/hex2_armv7l.hex1 ./armv7l/artifact/hex2-0
# hex2 adds long labels and absolute addresses, making it an effective linker
# for later stages.  This armv7l hex2-0 also carries the arch's pointer
# semantics (~ 3-byte, ^ aligned branch imm24, < align).

#################################
# Phase-2b Build catm from hex2 #
#################################
./armv7l/artifact/hex2-0 ./armv7l/catm_armv7l.hex2 ./armv7l/artifact/catm
# catm removes the need for shell redirection

###############################
# Phase-3 Build M0 from hex2  #
###############################
./armv7l/artifact/catm ./armv7l/artifact/M0.hex2 ./armv7l/ELF-armv7l.hex2 ./armv7l/M0_armv7l.hex2
./armv7l/artifact/hex2-0 ./armv7l/artifact/M0.hex2 ./armv7l/artifact/M0
# M0 is the architecture specific version of M1

#####################################
# Phase-4 Build cc_armv7l from M0   #
#####################################
./armv7l/artifact/M0 ./armv7l/cc_armv7l.M1 ./armv7l/artifact/cc_armv7l-0.hex2
./armv7l/artifact/catm ./armv7l/artifact/cc_armv7l-1.hex2 ./armv7l/ELF-armv7l.hex2 ./armv7l/artifact/cc_armv7l-0.hex2
./armv7l/artifact/hex2-0 ./armv7l/artifact/cc_armv7l-1.hex2 ./armv7l/artifact/cc_armv7l

###########################################
# Phase-5 Build M2-Planet from cc_armv7l  #
###########################################
./armv7l/artifact/catm ./armv7l/artifact/M2-0.c \
	./M2libc/armv7l/linux/bootstrap.c \
	./M2-Planet/cc.h \
	./M2libc/bootstrappable.c \
	./M2-Planet/cc_globals.c \
	./M2-Planet/cc_reader.c \
	./M2-Planet/cc_strings.c \
	./M2-Planet/cc_types.c \
	./M2-Planet/cc_emit.c \
	./M2-Planet/cc_core.c \
	./M2-Planet/cc_macro.c \
	./M2-Planet/cc.c
./armv7l/artifact/cc_armv7l ./armv7l/artifact/M2-0.c ./armv7l/artifact/M2-0.M1
./armv7l/artifact/catm ./armv7l/artifact/M2-0-0.M1 ./armv7l/armv7l_defs.M1 ./armv7l/libc-core.M1 ./armv7l/artifact/M2-0.M1
./armv7l/artifact/M0 ./armv7l/artifact/M2-0-0.M1 ./armv7l/artifact/M2-0.hex2
./armv7l/artifact/catm ./armv7l/artifact/M2-0-0.hex2 ./armv7l/ELF-armv7l.hex2 ./armv7l/artifact/M2-0.hex2
./armv7l/artifact/hex2-0 ./armv7l/artifact/M2-0-0.hex2 ./armv7l/artifact/M2

#############################################
# Phase-6 Build blood-elf-0 from C sources  #
#############################################
./armv7l/artifact/M2 --architecture armv7l \
	-f ./M2libc/armv7l/linux/bootstrap.c \
	-f ./M2libc/bootstrappable.c \
	-f ./mescc-tools/stringify.c \
	-f ./mescc-tools/blood-elf.c \
	--bootstrap-mode \
	-o ./armv7l/artifact/blood-elf-0.M1

./armv7l/artifact/catm ./armv7l/artifact/blood-elf-0-0.M1 ./M2libc/armv7l/armv7l_defs.M1 ./M2libc/armv7l/libc-core.M1 ./armv7l/artifact/blood-elf-0.M1
./armv7l/artifact/M0 ./armv7l/artifact/blood-elf-0-0.M1 ./armv7l/artifact/blood-elf-0.hex2
./armv7l/artifact/catm ./armv7l/artifact/blood-elf-0-0.hex2 ./M2libc/armv7l/ELF-armv7l.hex2 ./armv7l/artifact/blood-elf-0.hex2
./armv7l/artifact/hex2-0 ./armv7l/artifact/blood-elf-0-0.hex2 ./armv7l/artifact/blood-elf-0
# This is the last stage where the binaries will not have debug info

#####################################
# Phase-7 Build M1-0 from C sources #
#####################################
./armv7l/artifact/M2 --architecture armv7l \
	-f ./M2libc/armv7l/linux/bootstrap.c \
	-f ./M2libc/bootstrappable.c \
	-f ./mescc-tools/stringify.c \
	-f ./mescc-tools/M1-macro.c \
	--bootstrap-mode \
	--debug \
	-o ./armv7l/artifact/M1-macro-0.M1

./armv7l/artifact/blood-elf-0 -f ./armv7l/artifact/M1-macro-0.M1 --little-endian -o ./armv7l/artifact/M1-macro-0-footer.M1
./armv7l/artifact/catm ./armv7l/artifact/M1-macro-0-0.M1 ./M2libc/armv7l/armv7l_defs.M1 ./M2libc/armv7l/libc-core.M1 ./armv7l/artifact/M1-macro-0.M1 ./armv7l/artifact/M1-macro-0-footer.M1
./armv7l/artifact/M0 ./armv7l/artifact/M1-macro-0-0.M1 ./armv7l/artifact/M1-macro-0.hex2
./armv7l/artifact/catm ./armv7l/artifact/M1-macro-0-0.hex2 ./M2libc/armv7l/ELF-armv7l-debug.hex2 ./armv7l/artifact/M1-macro-0.hex2
./armv7l/artifact/hex2-0 ./armv7l/artifact/M1-macro-0-0.hex2 ./armv7l/artifact/M1-0

# This is the last stage where M0 is used; from here on M1 does the work.
# NOTE (armv7l-specific): M0 must implement the '~' 24-bit
# immediate for this phase's M2libc streams to link correctly — no other
# arch's M0 needs it and none implements it.

#######################################
# Phase-8 Build hex2-1 from C sources #
#######################################
./armv7l/artifact/M2 --architecture armv7l \
	-f ./M2libc/sys/types.h \
	-f ./M2libc/stddef.h \
	-f ./M2libc/sys/utsname.h \
	-f ./M2libc/armv7l/linux/unistd.c \
	-f ./M2libc/armv7l/linux/fcntl.c \
	-f ./M2libc/fcntl.c \
	-f ./M2libc/armv7l/linux/sys/stat.c \
	-f ./M2libc/ctype.c \
	-f ./M2libc/stdlib.c \
	-f ./M2libc/stdarg.h \
	-f ./M2libc/stdio.h \
	-f ./M2libc/stdio.c \
	-f ./M2libc/bootstrappable.c \
	-f ./mescc-tools/hex2.h \
	-f ./mescc-tools/hex2_linker.c \
	-f ./mescc-tools/hex2_word.c \
	-f ./mescc-tools/hex2.c \
	--debug \
	-o ./armv7l/artifact/hex2_linker-0.M1

./armv7l/artifact/blood-elf-0 -f ./armv7l/artifact/hex2_linker-0.M1 --little-endian -o ./armv7l/artifact/hex2_linker-0-footer.M1

./armv7l/artifact/M1-0 --architecture armv7l \
	--little-endian \
	-f ./M2libc/armv7l/armv7l_defs.M1 \
	-f ./M2libc/armv7l/libc-full.M1 \
	-f ./armv7l/artifact/hex2_linker-0.M1 \
	-f ./armv7l/artifact/hex2_linker-0-footer.M1 \
	-o ./armv7l/artifact/hex2_linker-0.hex2

./armv7l/artifact/catm ./armv7l/artifact/hex2_linker-0-0.hex2 ./M2libc/armv7l/ELF-armv7l-debug.hex2 ./armv7l/artifact/hex2_linker-0.hex2

./armv7l/artifact/hex2-0 ./armv7l/artifact/hex2_linker-0-0.hex2 ./armv7l/artifact/hex2-1

# This is the last stage using the hand-written hex2

###################################
# Phase-9 Build M1 from C sources #
###################################
./armv7l/artifact/M2 --architecture armv7l \
	-f ./M2libc/sys/types.h \
	-f ./M2libc/stddef.h \
	-f ./M2libc/sys/utsname.h \
	-f ./M2libc/armv7l/linux/fcntl.c \
	-f ./M2libc/fcntl.c \
	-f ./M2libc/armv7l/linux/unistd.c \
	-f ./M2libc/stdarg.h \
	-f ./M2libc/string.c \
	-f ./M2libc/ctype.c \
	-f ./M2libc/stdlib.c \
	-f ./M2libc/stdio.h \
	-f ./M2libc/stdio.c \
	-f ./M2libc/bootstrappable.c \
	-f ./mescc-tools/stringify.c \
	-f ./mescc-tools/M1-macro.c \
	--debug \
	-o ./armv7l/artifact/M1-macro-1.M1

./armv7l/artifact/blood-elf-0 -f ./armv7l/artifact/M1-macro-1.M1 --little-endian -o ./armv7l/artifact/M1-macro-1-footer.M1

./armv7l/artifact/M1-0 --architecture armv7l \
	--little-endian \
	-f ./M2libc/armv7l/armv7l_defs.M1 \
	-f ./M2libc/armv7l/libc-full.M1 \
	-f ./armv7l/artifact/M1-macro-1.M1 \
	-f ./armv7l/artifact/M1-macro-1-footer.M1 \
	-o ./armv7l/artifact/M1-macro-1.hex2

./armv7l/artifact/hex2-1 --architecture armv7l \
	--little-endian \
	--base-address 0x00010000 \
	-f ./M2libc/armv7l/ELF-armv7l-debug.hex2 \
	-f ./armv7l/artifact/M1-macro-1.hex2 \
	-o ./armv7l/bin/M1

######################################
# Phase-10 Build hex2 from C sources #
######################################
./armv7l/artifact/M2 --architecture armv7l \
	-f ./M2libc/sys/types.h \
	-f ./M2libc/stddef.h \
	-f ./M2libc/sys/utsname.h \
	-f ./M2libc/armv7l/linux/unistd.c \
	-f ./M2libc/armv7l/linux/fcntl.c \
	-f ./M2libc/fcntl.c \
	-f ./M2libc/armv7l/linux/sys/stat.c \
	-f ./M2libc/ctype.c \
	-f ./M2libc/stdlib.c \
	-f ./M2libc/stdarg.h \
	-f ./M2libc/stdio.h \
	-f ./M2libc/stdio.c \
	-f ./M2libc/bootstrappable.c \
	-f ./mescc-tools/hex2.h \
	-f ./mescc-tools/hex2_linker.c \
	-f ./mescc-tools/hex2_word.c \
	-f ./mescc-tools/hex2.c \
	--debug \
	-o ./armv7l/artifact/hex2_linker-2.M1

./armv7l/artifact/blood-elf-0 -f ./armv7l/artifact/hex2_linker-2.M1 --little-endian -o ./armv7l/artifact/hex2_linker-2-footer.M1

./armv7l/bin/M1 --architecture armv7l \
	--little-endian \
	-f ./M2libc/armv7l/armv7l_defs.M1 \
	-f ./M2libc/armv7l/libc-full.M1 \
	-f ./armv7l/artifact/hex2_linker-2.M1 \
	-f ./armv7l/artifact/hex2_linker-2-footer.M1 \
	-o ./armv7l/artifact/hex2_linker-2.hex2

./armv7l/artifact/hex2-1 --architecture armv7l \
	--little-endian \
	--base-address 0x00010000 \
	-f ./M2libc/armv7l/ELF-armv7l-debug.hex2 \
	-f ./armv7l/artifact/hex2_linker-2.hex2 \
	-o ./armv7l/bin/hex2

#####################################
# Phase-11 Build kaem from C sources#
#####################################
./armv7l/artifact/M2 --architecture armv7l \
	-f ./M2libc/sys/types.h \
	-f ./M2libc/stddef.h \
	-f ./M2libc/sys/utsname.h \
	-f ./M2libc/armv7l/linux/unistd.c \
	-f ./M2libc/armv7l/linux/fcntl.c \
	-f ./M2libc/fcntl.c \
	-f ./M2libc/ctype.c \
	-f ./M2libc/stdlib.c \
	-f ./M2libc/string.c \
	-f ./M2libc/stdarg.h \
	-f ./M2libc/stdio.h \
	-f ./M2libc/stdio.c \
	-f ./M2libc/bootstrappable.c \
	-f ./mescc-tools/Kaem/kaem.h \
	-f ./mescc-tools/Kaem/variable.c \
	-f ./mescc-tools/Kaem/kaem_globals.c \
	-f ./mescc-tools/Kaem/kaem.c \
	--debug \
	-o ./armv7l/artifact/kaem.M1

./armv7l/artifact/blood-elf-0 -f ./armv7l/artifact/kaem.M1 --little-endian -o ./armv7l/artifact/kaem-footer.M1

./armv7l/bin/M1 --architecture armv7l \
	--little-endian \
	-f ./M2libc/armv7l/armv7l_defs.M1 \
	-f ./M2libc/armv7l/libc-full.M1 \
	-f ./armv7l/artifact/kaem.M1 \
	-f ./armv7l/artifact/kaem-footer.M1 \
	-o ./armv7l/artifact/kaem.hex2

./armv7l/bin/hex2 --architecture armv7l \
	--little-endian \
	-f ./M2libc/armv7l/ELF-armv7l-debug.hex2 \
	-f ./armv7l/artifact/kaem.hex2 \
	--base-address 0x00010000 \
	-o ./armv7l/bin/kaem
