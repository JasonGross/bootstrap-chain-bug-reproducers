## armv7l stage0-cc runtime prelude (transliterated from x86/libc-core.M1;
## ABI summarised in this entry's run.sh header). main is entered with
## [BP-4]=argc, [BP-8]=argv, [BP-12]=envp — the same in-place-argc trick as
## the x86 original. Exit code = main's R0. The cc_sdiv/cc_smod software
## division routines below are generated from GAS/cc_libc_armv7l.S (raw
## words, internal branches baked; see that file for the algorithm).

:_start
	MOVE_BP_FROM_SP             ; Protect sp

	;; Prepare argv
	ADD_R0_SP_4                 ; ARGV_address = SP + 4
	PUSH_R0                     ; Put argv on the stack

	;; Prepare envp
	LOAD_R0_FROM_BP             ; Get ARGC
	ADD_R0_2                    ; OFFSET = ARGC + 2
	LSL2_R0                     ; OFFSET = OFFSET * WORDSIZE
	ADD_R0_BP                   ; ENVP_address = SP_entry + OFFSET
	PUSH_R0                     ; Put envp on the stack

	;; Stack offset
	ADD_BP_4                    ; Fix BP so [BP-4] = argc in place

	;; Occupy the slot x86's `call` would push a return address into: ARM
	;; `bl` puts the link in LR, not on the stack, but the cc's local-depth
	;; constants assume the x86 geometry (first local at BP-20 lands one word
	;; below the return-address slot). Pushing LR restores that word.
	PUSH_LR

	;; Perform the main loop
	^~FUNCTION_main
	CALL_IMMEDIATE

	;; Exit to kernel with main's return code (already in R0)
	SET_R7_TO_1                 ; Syscall exit
	SYSCALL                     ; Exit with that code

